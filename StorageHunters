local function WaitForAuctionFinished(runId, pickupSerialAtStart, soldSerialAtStart, wonSerialAtStart)
    local sawOpen = false
    local closedChecks = 0
    local waitStarted = os.clock()
    
    while not HubDestroyed
        and State.Farming
        and RunIds.Farming == runId do

                                                                           
                                                                            
        local bidButton = GetBidButton()
        local canStillBid = AuctionIsOpen() and bidButton and bidButton.Visible and bidButton.Active
        if canStillBid then
            ThisHubInstance.EnsureBidPosition()
        end

                                                                            
        if not canStillBid and (
            ThisHubInstance.PickupStartSerial ~= pickupSerialAtStart
            or ThisHubInstance.AuctioneerSoldSerial ~= soldSerialAtStart
            or AuctionWonSerial ~= wonSerialAtStart) then
            ThisHubInstance.ActiveAuctionAreaOpen = false
            if FarmingCurrentGarage then
                FarmingCompletedGarage = FarmingCurrentGarage
            end
            return true
        end

        if ThisHubInstance.ActiveAuctionAreaOpen then
            ThisHubInstance.EnsureBidPosition()
            task.wait(0.02)
            continue
        end

        if not canStillBid and ThisHubInstance.AuctioneerSoldSerial ~= soldSerialAtStart then
            FarmingCompletedGarage = FarmingCurrentGarage
            return true
        end

                                                            
                                                                    
                                                                        
                                        
        if not canStillBid and AuctionWonSerial ~= wonSerialAtStart then
            FarmingCompletedGarage = FarmingCurrentGarage
            return true
        end

        if AuctionIsOpen() then
            sawOpen = true
            closedChecks = 0
        elseif sawOpen then
            closedChecks += 1

                                                                       
                                               
            if closedChecks >= 2 and not canStillBid then
                FarmingCompletedGarage = FarmingCurrentGarage
                return true
            end
        end

                                                                      
                                                          
        if os.clock() - waitStarted >= 60 and not AuctionIsOpen() then
            FarmingCompletedGarage = FarmingCurrentGarage
            FarmingBidGarage = nil
            return true
        end

        task.wait(0.02)
    end

    return false
end

                                                                
                                      
                                       
                                                   
                                                                           
                                                                

