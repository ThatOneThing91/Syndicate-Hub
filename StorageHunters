-- Track each slot's reveal/claim stage to avoid repeated reveals after success.
local slotCollection = {}

local function gradingActionRejected(ok, result)
    if not ok or result == false then return true end
    if type(result) == "table" then
        return result.success == false or result.Success == false
    end
    return false
end

local function gradingActionReason(result)
    if type(result) == "table" then
        return result.message or result.Message or result.error or result.Error or result.reason
    elseif type(result) == "string" then
        return result
    end
    return nil
end

