        TextColor3 = TextColor,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        BorderSizePixel = 0,
    }, holder)

    Corner(button, 5)

    local currentValue = initialValue
    local options = {}
    local labelFormatter
    local function label(value)
        return labelFormatter and labelFormatter(value) or tostring(value or "\078\111\110\101")
    end

    for _, option in ipairs(initialOptions or {}) do
        table.insert(options, option)
    end

    local object = {}

    function object:Get()
        return currentValue
    end

    function object:SetLabelFormatter(formatter)
        labelFormatter = formatter
        button.Text = label(currentValue)
    end

    function object:Set(value)
        currentValue = value
        button.Text = label(value)
    end

    function object:SetOptions(newOptions, selected)
        options = {}

        for _, option in ipairs(newOptions or {}) do
            table.insert(options, option)
        end

        if selected ~= nil then
            currentValue = selected
        elseif #options > 0 then
            currentValue = options[1]
        else
            currentValue = "\078\111\032\097\117\099\116\105\111\110\115\032\102\111\117\110\100"
        end

        button.Text = label(currentValue)
    end

    TrackConnection(
        button.Activated:Connect(function()
            if HubDestroyed or #options == 0 then
                return
            end

            if object.BeforeOpen then object.BeforeOpen() end
            CloseDropdown()

            local frameHeight = math.min(280, (#options * 32) + 8)

            local optionsFrame = New("\083\099\114\111\108\108\105\110\103\070\114\097\109\101", {
                Size = UDim2.fromOffset(
                    math.max(180, holder.AbsoluteSize.X),
