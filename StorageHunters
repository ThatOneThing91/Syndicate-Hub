    end

    local function PlantRoot(plant)
        local root = plant:FindFirstChild("\082\111\111\116")
        if root and root:IsA("\066\097\115\101\080\097\114\116") then return root end
        if root and root:IsA("\077\111\100\101\108") then
            return root.PrimaryPart or root:FindFirstChildWhichIsA("\066\097\115\101\080\097\114\116", true)
        end
        return nil
    end

    local function RoundOf(plant)
        return plant:GetAttribute("\082\111\117\110\100"), plant:GetAttribute("\087\097\116\101\114\101\100\082\111\117\110\100")
    end

    local function IsFullyGrown(plant)
                                                                           
                                                       
        for _, name in ipairs({"\070\117\108\108\121\071\114\111\119\110", "\073\115\070\117\108\108\121\071\114\111\119\110", "\077\097\116\117\114\101", "\073\115\077\097\116\117\114\101", "\071\114\111\119\110"}) do
            if plant:GetAttribute(name) == true then return true end
        end
        for _, name in ipairs({"\071\114\111\119\116\104\080\114\111\103\114\101\115\115", "\071\114\111\119\080\114\111\103\114\101\115\115", "\071\114\111\119\116\104\080\101\114\099\101\110\116"}) do
            local progress = plant:GetAttribute(name)
            if type(progress) == "\110\117\109\098\101\114" and progress >= 100 then return true end
        end
        local root = plant:FindFirstChild("\082\111\111\116")
        if root then
            for _, descendant in ipairs(root:GetDescendants()) do
                if descendant:IsA("\080\114\111\120\105\109\105\116\121\080\114\111\109\112\116") and descendant.Enabled
                    and (descendant.Name:lower():find("\104\097\114\118\101\115\116", 1, true)
                    or descendant.ActionText:lower():find("\104\097\114\118\101\115\116", 1, true)) then
                    return true
                end
            end
        end
        return false
    end

    local function OwnedFloor()
        if LocalPlayer:GetAttribute("\073\110\067\108\117\098\104\111\117\115\101") == true
            or LocalPlayer:GetAttribute("\080\108\111\116\083\108\111\116\083\119\105\116\099\104\105\110\103") == true then
            return nil
        end
        local plots = workspace:FindFirstChild("\095\080\108\111\116\115")
        if not plots then return nil end
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:GetAttribute("\079\119\110\101\114\085\115\101\114\073\100") == LocalPlayer.UserId then
                local base = plot:FindFirstChild("\066\097\115\101")
                local floor = base and base:FindFirstChild("\070\108\111\111\114")
                if floor and floor:IsA("\066\097\115\101\080\097\114\116") then return floor end
            end
        end
        return nil
    end

    local function OnOwnedPlot(root, floor)
        if not root or not floor then return false end
        local pos = floor.CFrame:PointToObjectSpace(root.Position)
        return math.abs(pos.X) <= floor.Size.X * 0.5 + 0.1
            and math.abs(pos.Z) <= floor.Size.Z * 0.5 + 0.1
    end

    local function MarkerFor(plant)
        local round = plant:GetAttribute("\082\111\117\110\100")
        return round ~= nil and tostring(round) or "\117\110\107\110\111\119\110\045\114\111\117\110\100"
    end

    local function NeedsWater(plant)
        if not plant.Parent or IsFullyGrown(plant) then return false end
        local round, wateredRound = RoundOf(plant)
        if round ~= nil and wateredRound == round then return false end
        if attempted[plant] == MarkerFor(plant) then return false end
        return true
    end

    local function StartWatering(id)
        task.spawn(function()
            while Active(id) do
                local folder = workspace:FindFirstChild("\095\071\097\114\100\101\110\115")
                local floor = OwnedFloor()
                local didWork = false

                if folder and floor and waterRemote and waterRemote:IsA("\082\101\109\111\116\101\070\117\110\099\116\105\111\110") then
                    for _, plant in ipairs(folder:GetChildren()) do
                        if not Active(id) then break end
                                                                           
                                                                     
                        if pendingInvoke then break end

                        local target = PlantRoot(plant)
                        if target and OnOwnedPlot(target, floor) and NeedsWater(plant) then
                            local can = EquippedCan() or FindCanInInventory(id)
                            if not can then break end
                            local rootPart = GetRoot()
                            if not rootPart then break end

                                                                        
                            local targetPos = target.Position
                            local delta = Vector3.new(
                                targetPos.X - rootPart.Position.X,
                                0,
                                targetPos.Z - rootPart.Position.Z
                            )
                            local direction = delta.Magnitude > 0.1
                                and delta.Unit or Vector3.new(0, 0, -1)
                            local distance = config.WateringForwardDistance or 4
                            local stand = targetPos - direction * distance
                            local standPos = Vector3.new(
                                stand.X, targetPos.Y + 2.5, stand.Z
                            )
                            local intended = CFrame.lookAt(
                                standPos, standPos + direction
                            )
                            rootPart.CFrame = intended
                            task.wait(0.25)

                            if not Active(id) then break end
                            if not NeedsWater(plant) then continue end
                            if not OnOwnedPlot(target, OwnedFloor()) then continue end

                            rootPart = GetRoot()
                            can = EquippedCan()
                            if not rootPart or not can then continue end

                                                                             
                            rootPart.CFrame = intended
                            task.wait(0.1)
                            if not Active(id) or not NeedsWater(plant) then continue end

                                                                            
                                                                                   
                            attempted[plant] = MarkerFor(plant)
                            pendingInvoke = true
                            didWork = true

                            local finished, ok, result = false, false, nil
                            task.spawn(function()
                                ok, result = pcall(function()
                                    return waterRemote:InvokeServer(can)
                                end)
                                finished = true
                                pendingInvoke = false
                            end)

                                                                                  
                                                                               
                            local deadline = os.clock() + 8
                            while Active(id) and not finished and os.clock() < deadline do
                                task.wait(0.1)
                            end
                            if not Active(id) then break end
                            if not finished then
                                                                                       
                                lastUncertain = os.clock()
                                break
                            end

                                                                            
                            local confirmDeadline = os.clock() + 2
                            local confirmed = false
                            repeat
                                local round, wateredRound = RoundOf(plant)
                                if round ~= nil and wateredRound == round then
                                    confirmed = true
                                    break
                                end
                                if not Active(id) then break end
                                task.wait(0.1)
                            until os.clock() >= confirmDeadline

                                                                             
                                                                                 
                            if not confirmed and (not ok or result == false) then
                                lastUncertain = os.clock()
                            end
                            task.wait(0.2)
                        end
                    end
                end

                                                                                
                task.wait(didWork and 0.7 or 2)
            end
        end)
    end

    CreateToggle(MainPage, "\065\117\116\111\032\087\097\116\101\114\032\080\108\097\110\116\115", "\065\117\116\111\087\097\116\101\114\080\108\097\110\116\115", function(enabled)
        RunIds.WaterPlants += 1
        if enabled then StartWatering(RunIds.WaterPlants) end
    end)
end

                                                                
                                            
                                                                
do
    local crops = require(ReplicatedStorage.Modules.GardenCrops)
    local config = require(ReplicatedStorage.Modules.GardenConfig)
    local gardenEvents = ReplicatedStorage:WaitForChild("\069\118\101\110\116\115")
    local gardenFolder = gardenEvents:FindFirstChild(config.RemoteFolder)
    local plantRemote = gardenFolder and gardenFolder:FindFirstChild("\080\108\097\110\116")
    local inventoryEvents = gardenEvents:FindFirstChild("\073\110\118\101\110\116\111\114\121")
    local equipRemote = inventoryEvents and inventoryEvents:FindFirstChild("\069\113\117\105\112\073\116\101\109")
    local inventoryRemote = inventoryEvents and inventoryEvents:FindFirstChild("\071\101\116\080\108\097\121\101\114\073\110\118\101\110\116\111\114\121")

    local function Active(id)
        return not HubDestroyed and State.AutoPlantSeeds and RunIds.PlantSeeds == id
    end

    local function OwnFloor()
        if LocalPlayer:GetAttribute("\073\110\067\108\117\098\104\111\117\115\101") == true
            or LocalPlayer:GetAttribute("\080\108\111\116\083\108\111\116\083\119\105\116\099\104\105\110\103") == true then return nil end
        local plots = workspace:FindFirstChild("\095\080\108\111\116\115")
        if not plots then return nil end
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:GetAttribute("\079\119\110\101\114\085\115\101\114\073\100") == LocalPlayer.UserId then
