    inventory = inventory.Inventory or inventory.Items or inventory
    local scanned, budgetStart = 0, os.clock()
    for guid, item in pairs(inventory) do
        if HubDestroyed or not State.AutoRepair or RunIds.Repair ~= runId then
            return nil, nil
