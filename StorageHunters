        if type(item) == "\116\097\098\108\101"
            and RepairContainsBroken(item)
            and not ThisHubInstance.IsFishingRodForRepair(item) then
            return guid, item
        end
        scanned = scanned + 1
        if scanned % 100 == 0 or os.clock() - budgetStart >= 0.002 then
            task.wait()
            budgetStart = os.clock()
