                return nil,nil
            end
            local function decide()
                if closed or not active
                    or offerTickets[guid]~=ticket then return end
                local pct,source=eventPercent,"ShowOffer price / item value"
                if pct==nil then pct,source=bubblePercent() end
                if pct==nil and percent<=-100 then
                    pct,source=-100,"accept all threshold"
                end
                if pct==nil then
                    statusText.Text="ShowOffer received · price/value unavailable; watching sign"
                    return
                end
                statusText.Text="Offer "..tostring(math.floor(pct*10+.5)/10)..
                    "% ("..source..")"
                handleOffer(guid,pct)
            end
            -- The game needs a moment to populate the bubble and server
            -- offer state before a response is sent.
            task.spawn(function()
                task.wait(.3)
                local ok,err=pcall(decide)
                if not ok then
                    statusText.Text="Offer handler error (console)"
                    warn("[Auto Shop Offers] "..tostring(err))
                end
            end)
            return
        end
        if sourceName=="HideOffer" then
            local guid=...
            if uuid(guid) then
                pendingIds[guid]=nil
                offerTickets[guid]=nil
                eventOffers[guid]=nil
            else
                pendingIds={}
                offerTickets={}
                eventOffers={}
            end
            guiHandled={}
            statusText.Text="Offer closed; waiting for next customer"
            return
        end
        local args={...}
        local offerSignal=sourceName=="OfferPresented" or sourceName=="ShowOffer"
        if offerSignal then lastIncomingOfferAt=os.clock() end
        local possibleId,idCount=nil,0
        for _,arg in ipairs(args) do
            if uuid(arg) then
                possibleId=arg
                idCount=idCount+1
            end
        end
        if idCount~=1 then possibleId=nil end
        if offerSignal and possibleId and not decided[possibleId] then
            pendingIds[possibleId]=os.clock()
            -- -100% means accept every valid offer regardless of price;
            -- this decision requires only the current live offer GUID.
            if percent<=-100 then
                handleOffer(possibleId,-100)
                return
            end
        end
        local seen={}
        if offerSignal then
            for _,arg in ipairs(args) do
                if type(arg)=="table" or typeof(arg)=="Instance" then
                    inspect(arg,possibleId,0,seen)
                end
            end
            -- Some client events provide a signed percent as a plain
            -- string ("-15%") alongside the live UUID.
            -- The parser is declared below; this path uses event text only.
            if possibleId then
                local signed=nil
                for _,arg in ipairs(args) do
                    if type(arg)=="string" and not uuid(arg) then
                        local normalized=arg:gsub("−","-")
                        local match=normalized:match("([+-]%s*%d+%.?%d*)%s*%%")
                        if match then
                            local clean=match:gsub("%s+","")
                            local number=tonumber(clean)
                            if number then
                                if signed~=nil and math.abs(signed-number)>.01 then
                                    signed=nil
                                    break
                                end
                                signed=number
                            end
                        end
                    end
                end
                if signed~=nil then handleOffer(possibleId,signed) end
            end
        end
        if offerSignal then
            if possibleId and decided[possibleId] then
                -- The response was already sent in this event handler.
            elseif possibleId then
                statusText.Text="Customer offer detected; reading value..."
            else
                statusText.Text=sourceName.." detected; locating offer GUID..."
            end
        end
        -- Without known field names, raw numbers could mean prices,
        -- customer stats or percentages. Don't guess argument order.
    end
    -- Other NPCShopper scripts sometimes show the offer only through
    -- the customer's GUI, not an NPCShopper OnClientEvent. Observe visible
    -- Accept / Decline controls and their offer comparison.
    local player=game:GetService("Players").LocalPlayer
    local guiCache={}
    local function visible(item)
        local node=item
        while node do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("LayerCollector") and not node.Enabled then return false end
            node=node.Parent
        end
        return true
    end
    local function parseMoney(value)
        if type(value)~="string" then return nil end
        local raw=value:match("%$%s*([%d,%.]+%s*[kKmMbBtT]?)")
        if not raw then return nil end
        local amount,suffix=raw:match("([%d,%.]+)%s*([kKmMbBtT]?)")
        if not amount then return nil end
        local cleaned=amount:gsub(",","")
        local v=tonumber(cleaned)
        if not v then return nil end
        local mult={k=1e3,m=1e6,b=1e9,t=1e12}
        return v*(mult[suffix:lower()] or 1)
    end
    local function signedPercent(value)
        if type(value)~="string" then return nil end
        local s=value:gsub("−","-"):gsub("＋","+")
        local raw=s:match("([+-]%s*%d+%.?%d*)%s*%%")
        if not raw then return nil end
        local cleaned=raw:gsub("%s+","")
        return tonumber(cleaned)
    end
    local function buttonLabel(node)
        if node:IsA("TextButton") then
            return (node.Text.." "..node.Name):lower()
        end
        local label=node:FindFirstChildWhichIsA("TextLabel",true)
        return (node.Name.." "..(label and label.Text or "")):lower()
    end
    local function readGuiOffer(container)
        local labels,acceptButton,declineButton,guiId={},nil,nil,nil
        -- The game's live offer GUI is named NPCShopperOffer_<offerGUID>.
        -- Wrappers and buttons have no GUID attributes. Resolve only the
        -- enclosing offer GUI, so simultaneous customers keep separate IDs.
        local ancestor=container
        while ancestor do
            local candidate=ancestor.Name:match("^NPCShopperOffer_(.+)$")
            if uuid(candidate) then
                guiId=candidate
                break
            end
            ancestor=ancestor.Parent
        end
        for _,node in ipairs(container:GetDescendants()) do
            if node:IsA("GuiObject") and visible(node) then
                if node:IsA("TextLabel") or node:IsA("TextButton") or
                    node:IsA("TextBox") then
                    if node.Text~="" then labels[#labels+1]=node.Text end
                end
                if node:IsA("GuiButton") then
                    local value=buttonLabel(node)
                    if (value:find("accept",1,true) or
                        value:find("agree",1,true) or
                        value:match("^yes%s") or value:match("%syes%s")) and
                        not acceptButton then acceptButton=node end
                    if (value:find("decline",1,true) or
                        value:find("reject",1,true) or
                        value:find("refuse",1,true) or value:match("%sno%s")) and
                        not declineButton then declineButton=node end
                end
            end
            -- Offer GUIDs can live on a frame, a button, or a StringValue.
            if not guiId then
                if node:IsA("StringValue") and uuid(node.Value) then
                    guiId=node.Value
                else
                    for key,val in pairs(node:GetAttributes()) do
                        local k=key:lower()
                        if uuid(val) and (k:find("offer",1,true) or
                            k:find("shopper",1,true) or k=="guid") then
                            guiId=val
                            break
                        end
                    end
                end
            end
        end
        for key,val in pairs(container:GetAttributes()) do
            if not guiId and uuid(val) and (key:lower():find("offer",1,true) or
                key:lower():find("shopper",1,true)) then
                guiId=val; break
            end
        end
        local pct,offered,worth=nil,nil,nil
        local hasOfferContext=false
        for _,str in ipairs(labels) do
            local lower=str:lower()
            if lower:find("offer",1,true) or
                lower:find("customer",1,true) or
                lower:find("shopper",1,true) then
                hasOfferContext=true
            end
        end
        local node=container
        for _=1,5 do
            if not node or not node:IsA("GuiObject") then break end
            local title=node.Name:lower()
            if title:find("offer",1,true) or
                title:find("shopper",1,true) or
                title:find("customer",1,true) then
                hasOfferContext=true
                break
            end
            node=node.Parent
        end
        -- The live world-space offer signs show "$4.39 [+29%]" with
        -- ACCEPT / DECLINE. They usually do not contain the word "offer".
        -- Validate the percent and button pair below instead.
        for _,str in ipairs(labels) do
            local sign=signedPercent(str)
            if sign~=nil and pct==nil then pct=sign end
            local lower=str:lower()
            local offerPos=lower:find("offer",1,true) or
                lower:find("bid",1,true)
            local worthPos=lower:find("worth",1,true) or
                lower:find("value",1,true) or
                lower:find("estimated",1,true)
            if offerPos then
                offered=offered or parseMoney(str:sub(offerPos))
            end
            if worthPos then
                worth=worth or parseMoney(str:sub(worthPos))
            end
        end
        local count=#labels
        -- Read the actual signed percentage on this individual shopper sign.
        -- Never decide based on guessed price math for the visible signs.
        if pct==nil or pct < -100 or pct > 100 or
           not acceptButton or not declineButton then return nil end
        return {container=container,accept=acceptButton,
            decline=declineButton,id=guiId,pct=pct,labels=labels,
            count=count,offered=offered,worth=worth}
    end
    -- Shopper offer buttons can be World BillboardGui/SurfaceGui objects.
    -- Index world GUI roots once and update the index as shoppers appear.
    local function indexWorldGui(node)
        if node:IsA("BillboardGui") or node:IsA("SurfaceGui") then
            worldGuiRoots[node]=true
        end
        if node:IsA("GuiButton") then offerButtons[node]=true end
    end
    local function guiOffers()
        local output,seenButtons={},{}
        for button in pairs(offerButtons) do
            if not button.Parent then
                offerButtons[button]=nil
                offerContainers[button]=nil
            elseif visible(button) then
                local label=buttonLabel(button)
                if label:find("accept",1,true) or label:find("agree",1,true) then
                    local container=offerContainers[button] or button.Parent
                    for level=1,9 do
                        if not container or container==workspace or container==player then break end
                        -- Never expand to all of PlayerGui or the whole map.
                        if container:IsA("PlayerGui") or
                            not (container:IsA("GuiObject") or container:IsA("LayerCollector")) then break end
                        local offer=readGuiOffer(container)
                        if offer and offer.accept==button then
                            offerContainers[button]=container
                            if not seenButtons[button] then
                                seenButtons[button]=true
                                output[#output+1]=offer
                            end
                            break
                        end
                        container=container.Parent
                    end
                end
            end
        end
        return output
    end
    offerPanelPercent=function()
        local found=guiOffers()
        if #found==0 then return nil end
        local value,guid=found[1].pct,found[1].id
        for i=2,#found do
            if math.abs(found[i].pct-value)>.02 or found[i].id~=guid then return nil end
        end
        return value,guid
    end
    local function pendingSingleId()
        local id,count=nil,0
        local now=os.clock()
        for guid,receivedAt in pairs(pendingIds) do
            if decided[guid] or now-receivedAt>8 then
                pendingIds[guid]=nil
            else
                count=count+1
                id=guid
            end
        end
        return count==1 and id or nil
    end
    local function clickNative(button,attempt)
        if not button or not button.Parent then return false,"Button disappeared" end
        -- Prefer the game's actual button listeners. The previous version
        -- fired Activated only; many game buttons use MouseButton1Click.
        local signal=(attempt%2==1) and button.MouseButton1Click or button.Activated
        if attempt<=2 then
            if type(getconnections)=="function" then
                local ok,connections=pcall(getconnections,signal)
                if ok and type(connections)=="table" then
                    local fired=0
                    for _,connection in ipairs(connections) do
                        if connection.Enabled~=false then
                            if type(connection.Fire)=="function" then
                                local good=pcall(function() connection:Fire() end)
                                if good then fired=fired+1 end
                            elseif type(connection.Function)=="function" then
                                local good=pcall(connection.Function)
                                if good then fired=fired+1 end
                            end
                        end
                    end
                    if fired>0 then
                        return true,(attempt==1 and "MouseButton1Click" or "Activated")..
                            " handlers"
                    end
                end
            end
            if type(firesignal)=="function" then
                local ok=pcall(function() firesignal(signal) end)
                if ok then return true,(attempt==1 and "MouseButton1Click" or "Activated")..
                    " signal" end
            end
            return false,"No executable GUI signal"
        end
        -- Last resort: a real click at the center of the currently visible
        -- world-space button. Protected for executors that block VIM.
        local pos,size=button.AbsolutePosition,button.AbsoluteSize
        local camera=workspace.CurrentCamera
        if not camera or size.X<=0 or size.Y<=0 then
            return false,"Button has no screen coordinates"
        end
        local x=math.floor(pos.X+size.X/2)
        local y=math.floor(pos.Y+size.Y/2)
        local viewport=camera.ViewportSize
        if x<0 or y<0 or x>=viewport.X or y>=viewport.Y then
            return false,"Offer button off-screen"
        end
        local ok,reason=pcall(function()
            local vim=game:GetService("VirtualInputManager")
            vim:SendMouseButtonEvent(x,y,0,true,game,0)
            vim:SendMouseButtonEvent(x,y,0,false,game,0)
        end)
        return ok,ok and "virtual mouse click" or tostring(reason)
    end
    local lastGuiSeen=0
    local function pollOfferGui()
        local dialogs=guiOffers()
        lastGui=dialogs
        if #dialogs==0 then
            guiHandled={}
            return
        end
        -- Process EVERY customer separately, including offers that were
        -- already showing before Auto Shop Offers was switched on.
        local activeButtons={}
        local worked=0
        for _,d in ipairs(dialogs) do
            if d.pct and d.pct>=-100 and d.pct<=100 and
               d.accept and d.decline then
                local choice=d.pct>=percent
                local target=choice and d.accept or d.decline
                activeButtons[d.accept]=true
                local event=d.id and eventOffers[d.id]
                -- Until the sign catches up with ShowOffer, its old text
                -- must not undo the authoritative price/value response.
                local fresh=true
                if event and event.pct~=nil and not event.synced then
                    fresh=math.abs(event.pct-d.pct)<1.01
                    if fresh then
                        event.synced=true
                        event.signPct=d.pct
                    end
                end
                if d.id then
                    local waiting=pendingIds[d.id] and os.clock()-pendingIds[d.id]<.4
                    local pct=event and event.signPct==d.pct and event.pct or d.pct
                    if fresh and not waiting and not alreadyDecided(d.id,pct) then
                        handleOffer(d.id,pct)
                        worked=worked+1
                    end
                else
                    local previous=guiHandled[d.accept]
                    -- A reused button with a new percentage is a new offer,
                    -- so it does not inherit the previous two-second delay.
                    if previous and (previous.percent~=d.pct or previous.target~=target) then
                        previous=nil
                    end
                    local now=os.clock()
                    local nextAttempt=(previous and previous.attempt or 0)+1
                    if nextAttempt>3 then nextAttempt=1 end
                    if not previous or now-previous.when>=2.0 then
                        local ok,method=clickNative(target,nextAttempt)
                        guiHandled[d.accept]={
                            when=now,attempt=nextAttempt,
                            target=target,choice=choice,percent=d.pct
                        }
                        worked=worked+1
                        statusText.Text=(choice and "ACCEPT " or "DECLINE ")..
                            tostring(math.floor(d.pct+.5)).."% · "..
                            tostring(method).." · "..tostring(#dialogs).." visible"
                        if not ok then
                            warn("[Auto Shop Offers] Couldn't click shopper: "..tostring(method))
                        end
                    end
                end
            end
        end
        for button in pairs(guiHandled) do
            if not activeButtons[button] then guiHandled[button]=nil end
        end
        if worked==0 and #dialogs>0 then
            statusText.Text=tostring(#dialogs).." visible offer(s) · checking responses"
        end
    end
