    local records = setmetatable({}, {__mode = "\107"})
    local connections = {}
    local currentGui, guiConnection
    local serial, queued = 0, false

    local function active()
        return not HubDestroyed and State.MoveJumpButton
    end

    local function watch(signal, callback)
        local connection = signal:Connect(callback)
        connections[#connections + 1] = connection
        return connection
    end

    local function apply(button, record)
        if not active() or not button.Parent or currentGui ~= record.gui
            or not button:IsDescendantOf(record.gui) then return end
        local size = record.original
        record.target = UDim2.new(
            size.X.Scale * 1.5, math.round(size.X.Offset * 1.5),
            size.Y.Scale * 1.5, math.round(size.Y.Offset * 1.5)
        )
        if button.Size ~= record.target then
            record.writing = true
            button.Size = record.target
            record.writing = false
        end
    end

    local function refresh()
        if not active() or not currentGui then return end
        local touch = currentGui:FindFirstChild("\084\111\117\099\104\071\117\105")
        local controls = touch and touch:FindFirstChild("\084\111\117\099\104\067\111\110\116\114\111\108\070\114\097\109\101")
        local button = controls and controls:FindFirstChild("\074\117\109\112\066\117\116\116\111\110")
        if not button or not button:IsA("\071\117\105\079\098\106\101\099\116") then return end
        local record = records[button]
        if not record then
            record = {original = button.Size, gui = currentGui}
            records[button] = record
            watch(button:GetPropertyChangedSignal("\083\105\122\101"), function()
                if not active() or record.writing or currentGui ~= record.gui
                    or not button:IsDescendantOf(record.gui)
                    or button.Size == record.target then return end
                                                                           
                                                                                    
                record.original = button.Size
                apply(button, record)
            end)
        end
        apply(button, record)
    end

    local function schedule()
        if not active() or queued then return end
        queued = true
        local id = serial
        task.defer(function()
            if id ~= serial then return end
            queued = false
            refresh()
        end)
    end

    local function attach(gui)
        if not active() or gui == currentGui then return end
        if guiConnection then guiConnection:Disconnect() end
        currentGui = gui
        guiConnection = watch(gui.DescendantAdded, function(object)
            if object.Name == "\074\117\109\112\066\117\116\116\111\110" or object.Name == "\084\111\117\099\104\071\117\105"
                or object.Name == "\084\111\117\099\104\067\111\110\116\114\111\108\070\114\097\109\101" then schedule() end
        end)
        schedule()
    end

    local function stop()
        serial = serial + 1
        queued = false
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
                                                                                    
        for button, record in pairs(records) do
            if button.Parent then
                pcall(function()
                    if button.Size ~= record.original then button.Size = record.original end
                end)
            end
        end
