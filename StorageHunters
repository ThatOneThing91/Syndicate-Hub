                and ThisHubInstance.ActiveAuctionAreaGarage ~= garage then

                PendingGarageEntry = nil
                FarmingBidGarage = nil
                return "\097\117\099\116\105\111\110\095\097\099\116\105\118\101"
            end

            started = true
            break
        end

        if AuctionIsOpen() then
            started = true
            break
        end

                                                                          
                                                                            
        -- Stay committed after arrival, including while the prompt is disabled
        -- during the server's auction-start transition. Only real invalidation
        -- or an explicit user selection change releases this garage.
        if State.SelectedArea ~= areaName or State.SelectedAuction ~= selectedAtEntry then
            PendingGarageEntry = nil
            FarmingBidGarage = nil
            FarmingWaitingGarage = nil
            return "\112\114\105\111\114\105\116\121\095\099\104\097\110\103\101\100"
        end

        local now = os.clock()
        if not garage.Parent or not garage:IsDescendantOf(workspace) then
            missingSince = missingSince or now
            if now - missingSince >= 3 then
                PendingGarageEntry = nil
                FarmingBidGarage = nil
                ThisHubInstance.AuctionSnapshots[areaName] = nil
                return "\117\110\097\118\097\105\108\097\098\108\101"
            end
        else
            missingSince = nil
            local currentPrompt = GetGaragePrompt(garage)
            if currentPrompt and currentPrompt.Enabled ~= false
                and now - lastPromptAttempt >= math.max(PROMPT_CONFIRM_WINDOW, currentPrompt.HoldDuration + 0.4) then
                -- Recheck the server/UI state before every retry. A disabled
                -- prompt alone is not evidence of an affordability failure.
                if not AuctionIsOpen() and not ThisHubInstance.ActiveAuctionAreaOpen then
                    if not CanAffordGarage(garage) then
                        PendingGarageEntry = nil
                        FarmingBidGarage = nil
                        return "\117\110\097\102\102\111\114\100\097\098\108\101"
                    end
    
                    local root = GetRoot()
                    local destination = GetGarageDestination(garage)
                    if root and destination then
                        local reach = math.max(3, math.min(10, currentPrompt.MaxActivationDistance - 1))
                        if (root.Position - destination.Position).Magnitude > reach then
                            TeleportToGarage(garage)
                        end
                        FireGaragePrompt(garage)
                    end
                end
                lastPromptAttempt = now
            end
        end

        task.wait(0.03)
    end

    if started then
        pickupSerialForAuction = ThisHubInstance.PickupStartSerial
        soldSerialForAuction = ThisHubInstance.AuctioneerSoldSerial
        wonSerialForAuction = AuctionWonSerial
    end

                                                                           
                                  
    if started and State.AutoBid then
        TeleportToBidEntrySquare()
    end

    PendingGarageEntry = nil

    if not started then
        FarmingBidGarage = nil
        return "\115\116\111\112\112\101\100"
    end

    local finished = WaitForAuctionFinished(runId, pickupSerialForAuction, soldSerialForAuction, wonSerialForAuction)

    FarmingBidGarage = nil

    if finished then
        FarmingCurrentGarage = nil
        return "\102\105\110\105\115\104\101\100"
    end

    return "\115\116\111\112\112\101\100"
end

                                                                
               
                                                                

