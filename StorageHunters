do
    local config = require(ReplicatedStorage.Modules.GardenConfig)
    local care = require(ReplicatedStorage.Modules.GardenCare)
    local items = require(ReplicatedStorage.Modules.Items)
    local events = ReplicatedStorage:WaitForChild("\069\118\101\110\116\115")
    local gardenEvents = events:FindFirstChild(config.RemoteFolder)
    local waterRemote = gardenEvents and gardenEvents:FindFirstChild("\087\097\116\101\114")
    local inventoryEvents = events:FindFirstChild("\073\110\118\101\110\116\111\114\121")
    local inventoryRemote = inventoryEvents and inventoryEvents:FindFirstChild("\071\101\116\080\108\097\121\101\114\073\110\118\101\110\116\111\114\121")
    local equipRemote = inventoryEvents and inventoryEvents:FindFirstChild("\069\113\117\105\112\073\116\101\109")

                                                                            
    local attempted = setmetatable({}, {__mode = "\107"})
    local pendingInvoke = false
    local lastUncertain = 0

    local function Active(id)
        return not HubDestroyed
            and State.AutoWaterPlants
            and RunIds.WaterPlants == id
    end

    local function IsCan(itemId)
        if itemId == nil then return false end
        local ok, valid = pcall(care.IsCan, itemId)
        if ok and valid then return true end
        local definition = items[tostring(itemId)]
        return definition ~= nil and definition.Interactive == "\087\097\116\101\114\105\110\103\067\097\110"
    end

    local function EquippedCan()
        local character = LocalPlayer.Character
        if not character then return nil end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("\084\111\111\108") and IsCan(child:GetAttribute("\073\116\101\109\073\100")) then
                return child
            end
        end
        return nil
    end

    local function FindCanInInventory(id)
        local equipped = EquippedCan()
        if equipped then return equipped end
        if not inventoryRemote or not equipRemote then return nil end
        local ok, response = pcall(function()
            return inventoryRemote:InvokeServer()
        end)
        if not ok or type(response) ~= "\116\097\098\108\101" then return nil end
        local inventory = response.Inventory or response.Items or response
        if type(inventory) ~= "\116\097\098\108\101" then return nil end
        for key, entry in pairs(inventory) do
            if not Active(id) then return nil end
            if type(entry) == "\116\097\098\108\101" then
                local itemId = entry.ItemId or entry.ItemID or entry.itemId
                if IsCan(itemId) then
                    local guid = entry.Guid or entry.GUID or entry.UUID or key
