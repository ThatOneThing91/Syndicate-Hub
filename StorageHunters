        if cargoShip then
            lostFound = cargoShip:FindFirstChild("\076\111\115\116\032\097\110\100\032\070\111\117\110\100\032\066\111\120")
        end

    elseif State.SelectedArea == "\067\097\114\103\111\032\084\114\097\105\110" then
        local cargoTrain = workspace:FindFirstChild("\067\097\114\103\111\084\114\097\105\110\083\116\111\112")

        if cargoTrain then
            local closestDistance = math.huge

            for _, object in ipairs(cargoTrain:GetChildren()) do
                if object.Name == "\076\111\115\116\032\097\110\100\032\070\111\117\110\100\032\066\111\120" then
                    local part =
                        object:IsA("\066\097\115\101\080\097\114\116")
                        and object
                        or object:FindFirstChildWhichIsA("\066\097\115\101\080\097\114\116", true)

                    if part then
                        local distance =
                            (part.Position - root.Position).Magnitude

                        if distance < closestDistance then
                            closestDistance = distance
                            lostFound = object
                        end
                    end
                end
            end
        end

    else
        local areas = workspace:FindFirstChild("\065\114\101\097\115")
        local area = areas and areas:FindFirstChild(State.SelectedArea)

        if area then
            lostFound = area:FindFirstChild("\076\111\115\116\032\097\110\100\032\070\111\117\110\100\032\066\111\120", true)
        end
    end

    if not lostFound then
