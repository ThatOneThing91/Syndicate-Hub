local function FishIndexDefinitions(data, depth, visited)
    if type(data) ~= "\116\097\098\108\101" or depth > 5 or visited[data] then return end
    visited[data] = true
    for key, value in pairs(data) do
        if type(value) == "\116\097\098\108\101" then
            local id = FishItemId(value) or tonumber(key)
            if id and (FishRodName(FishItemName(value))
                or FishRodCategory(value.Category or value.Type or value.ItemType)) then
                FishDefinitions[id] = value
            end
            FishIndexDefinitions(value, depth + 1, visited)
        end
    end
end

