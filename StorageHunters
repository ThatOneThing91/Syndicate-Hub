    end

    local lostFound

    if State.SelectedArea == "\072\097\108\108\111\119\101\101\110" then
        local areas = workspace:FindFirstChild("\065\114\101\097\115")
        local halloween = areas and areas:FindFirstChild("\072\097\108\108\111\119\101\101\110")
        lostFound = halloween and halloween:FindFirstChild("\076\111\115\116\032\097\110\100\032\070\111\117\110\100\032\066\111\120")

    elseif State.SelectedArea == "\067\097\114\103\111\032\083\104\105\112" then
