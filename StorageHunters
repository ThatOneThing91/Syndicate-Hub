                local floor = base and base:FindFirstChild("\070\108\111\111\114")
                if floor and floor:IsA("\066\097\115\101\080\097\114\116") then return floor end
            end
        end
    end

    local seedDefinitions = {}
    local function SeedName(value)
        return type(value) == "\115\116\114\105\110\103" and value:lower():find("\037\102\091\037\097\093\115\101\101\100\115\037\102\091\037\065\093") ~= nil
    end
    local function SeedId(item)
        return type(item) == "\116\097\098\108\101" and tonumber(item.ItemId or item.ItemID or item.itemId or item.Id or item.ID)
    end
    local function IndexSeeds(data, depth, seen)
        if type(data) ~= "\116\097\098\108\101" or depth > 6 or seen[data] then return end
        seen[data] = true
        for key, entry in pairs(data) do
            if type(entry) == "\116\097\098\108\101" then
                local id = SeedId(entry) or tonumber(key)
                local name = entry.Name or entry.ItemName or entry.DisplayName or entry.name
                if id and (SeedName(name) or SeedName(entry.Category) or SeedName(entry.Type)) then
                    seedDefinitions[id] = true
                end
                IndexSeeds(entry, depth + 1, seen)
            end
        end
    end
    pcall(function()
        local items = ReplicatedStorage.Modules:FindFirstChild("\073\116\101\109\115")
        if items then IndexSeeds(require(items), 0, {}) end
    end)

    local function IsSeedItem(item)
        if type(item) ~= "\116\097\098\108\101" then return false end
        local id = SeedId(item)
        if id then
            local ok, crop = pcall(crops.FromSeed, id)
            if ok and crop then return true end
        end
        return SeedName(item.Name or item.name or item.ItemName or item.itemName
            or item.DisplayName or item.displayName)
            or SeedName(item.Category or item.Type or item.ItemType)
            or (id and seedDefinitions[id] == true) or false
    end

    local function EquippedSeed()
        local char = LocalPlayer.Character
        if not char then return nil end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("\084\111\111\108") then
                local id = tonumber(tool:GetAttribute("\073\116\101\109\073\100") or tool:GetAttribute("\073\116\101\109\073\068"))
                if SeedName(tool.Name) or SeedName(tool:GetAttribute("\073\116\101\109\078\097\109\101"))
                    or (id and seedDefinitions[id]) then
                    return tool
                end
                if id then
                    local ok, crop = pcall(crops.FromSeed, id)
                    if ok and crop then return tool end
                end
            end
        end
    end

    local function EquipSeed(id)
        local tool = EquippedSeed()
        if tool then return tool end
        if not inventoryRemote or not equipRemote then return nil end
        local ok, result = pcall(function() return inventoryRemote:InvokeServer() end)
        if not ok or type(result) ~= "\116\097\098\108\101" then return nil end
        local items = result.Inventory or result.Items or result
        if type(items) ~= "\116\097\098\108\101" then return nil end
        for key, item in pairs(items) do
            if not Active(id) then return nil end
            if IsSeedItem(item) then
                local guid = item.Guid or item.GUID or item.UUID or key
                if type(guid) == "\115\116\114\105\110\103" then
                                                                          
                    pcall(function() equipRemote:FireServer(guid) end)
                    local deadline = os.clock() + 1.6
                    repeat
                        task.wait(0.10)
                        if not Active(id) then return nil end
                        tool = EquippedSeed()
                        if tool then return tool end
                    until os.clock() >= deadline
                end
            end
        end
        return nil
    end

                                                                                
                                                                             
    local recentPlantPositions = {}
    local RESERVATION_SECONDS = 8
    local PLANT_SPACING = 2.7
                                                                               
    local TREE_CLEARANCE = 1.6

    local function PlotContains(floor, worldPos)
        local localPos = floor.CFrame:PointToObjectSpace(worldPos)
        return math.abs(localPos.X) <= floor.Size.X / 2
            and math.abs(localPos.Z) <= floor.Size.Z / 2
    end

    local function ExistingPlants(floor)
        local positions = {}
        local seen = {}
        for _, folderName in ipairs({"\095\071\097\114\100\101\110\115", "\095\071\097\114\100\101\110\076\111\099\097\108"}) do
            local folder = workspace:FindFirstChild(folderName)
            if folder then
                for _, obj in ipairs(folder:GetDescendants()) do
                    if obj:IsA("\066\097\115\101\080\097\114\116") and (obj.Name == "\082\111\111\116"
                        or obj.Name == "\072\097\114\118\101\115\116") then
                        local model = obj:FindFirstAncestorOfClass("\077\111\100\101\108")
                        local key = model or obj
                        if not seen[key] and PlotContains(floor, obj.Position) then
                            seen[key] = true
                            table.insert(positions, obj.Position)
                        end
                    end
                end
            end
        end
        return positions
    end

    local function ClearPlantingSpot(pos, plants)
        for _, existing in ipairs(plants) do
            local dx, dz = pos.X - existing.X, pos.Z - existing.Z
            if dx * dx + dz * dz < TREE_CLEARANCE * TREE_CLEARANCE then
                return false
            end
        end
        local now = os.clock()
        for i = #recentPlantPositions, 1, -1 do
            local recent = recentPlantPositions[i]
            if now - recent.time >= RESERVATION_SECONDS then
                table.remove(recentPlantPositions, i)
            else
                local dx, dz = pos.X - recent.position.X, pos.Z - recent.position.Z
                if dx * dx + dz * dz < TREE_CLEARANCE * TREE_CLEARANCE then
                    return false
                end
            end
        end
        return true
    end

    local function StartPlanting(id)
        task.spawn(function()
            local slot = 0
            local failed = 0
            while Active(id) do
                local floor = OwnFloor()
                local root = GetRoot()
                local tool = floor and root and EquipSeed(id)
                if floor and root and tool and plantRemote
                    and plantRemote:IsA("\082\101\109\111\116\101\070\117\110\099\116\105\111\110") then
                                                                            
                                                                             
                    local spacing = PLANT_SPACING
                    local margin = 1.0
                    local halfX = floor.Size.X / 2 - margin
                    local halfZ = floor.Size.Z / 2 - margin
                    local centerX = math.clamp(floor.Size.X * 0.28, -halfX, halfX)
                    local centerZ = math.clamp(-floor.Size.Z * 0.36, -halfZ, halfZ)
                    local plants = ExistingPlants(floor)
                    local chosen = nil
                    local columns = math.max(1, math.floor((halfX * 2) / spacing) + 1)
                    local rows = math.max(1, math.floor((halfZ * 2) / spacing) + 1)
                    local capacity = columns * rows
                                                                               
                                                                              
                                                                       
                    local candidates = {}
                    for row = 0, rows - 1 do
                        for column = 0, columns - 1 do
                            local x = -halfX + column * (halfX * 2) / math.max(1, columns - 1)
                            local z = -halfZ + row * (halfZ * 2) / math.max(1, rows - 1)
                            local dx, dz = x - centerX, z - centerZ
                            candidates[#candidates + 1] = {
                                x = x, z = z,
                                distance = math.max(math.abs(dx), math.abs(dz))
                            }
                        end
                    end
                    table.sort(candidates, function(a, b)
                        return a.distance < b.distance
                    end)
                    for _, candidate in ipairs(candidates) do
                        if not Active(id) then break end
                        local pos = floor.CFrame:PointToWorldSpace(
                            Vector3.new(candidate.x, floor.Size.Y / 2, candidate.z))
                        if ClearPlantingSpot(pos, plants) then
                            chosen = pos
                            break
                        end
                    end
                    if chosen then
                        root.CFrame = CFrame.new(chosen + Vector3.new(0, 2.5, 0))
                        task.wait(0.12)
                        if not Active(id) then break end
                        local ok, result = pcall(function()
                            return plantRemote:InvokeServer(tool, chosen)
                        end)
                        if ok and type(result) == "\116\097\098\108\101" and result.Ok == true then
                            table.insert(recentPlantPositions, {
                                position = chosen,
                                time = os.clock()
                            })
                            failed = 0
                            task.wait(0.16)
                        else
                            failed += 1
                            task.wait(failed >= math.max(1, capacity) and 3 or 0.3)
                            if failed >= math.max(1, capacity) then failed = 0 end
                        end
                    else
                                                                                
                                                                                   
                        task.wait(2)
                    end
                else
                    task.wait(2)
                end
            end
        end)
    end

    CreateToggle(MainPage, "\065\117\116\111\032\080\108\097\110\116\032\083\101\101\100\115", "\065\117\116\111\080\108\097\110\116\083\101\101\100\115", function(enabled)
        RunIds.PlantSeeds += 1
        if enabled then StartPlanting(RunIds.PlantSeeds) end
    end)
end

