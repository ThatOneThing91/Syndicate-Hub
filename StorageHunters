-- Hay object positions can move in GetChildren() between game loads.
-- Locate named Hay instances instead of relying on numerical child indices.
local function GetHayTargets(trees)
    local targets = {}
    for _, target in ipairs(trees:GetDescendants()) do
        if (target:IsA("Model") or target:IsA("BasePart"))
            and target.Name:lower():find("hay", 1, true) then
            local parent = target.Parent
            local insideHay = false
            while parent and parent ~= trees do
                if (parent:IsA("Model") or parent:IsA("BasePart"))
                    and parent.Name:lower():find("hay", 1, true) then
                    insideHay = true
                    break
                end
                parent = parent.Parent
            end
            if not insideHay then table.insert(targets, target) end
        end
    end
    return targets
end

local function GetTreesFolder()
    local assets = workspace:FindFirstChild("BBOW Builder Assets")
    local buildings = assets and assets:FindFirstChild("Other Buildings and  Decoration")
    return buildings and buildings:FindFirstChild("Trees") or nil
end

local function StartHayCollector(runId)
    task.spawn(function()
        local targets, cachedTrees = {}, nil
        local lastScan = -math.huge
        local function active()
            return not HubDestroyed and State.HayCollector and RunIds.Hay == runId
        end

        while active() do
            local trees = GetTreesFolder()
            if not trees then
                cachedTrees = nil
                task.wait(1)
            else
                if trees ~= cachedTrees or os.clock() - lastScan >= 8 then
                    targets = GetHayTargets(trees)
                    cachedTrees = trees
                    lastScan = os.clock()
                end

                for _, target in ipairs(targets) do
                    if not active() then return end
                    if target:IsDescendantOf(trees) then
                        local root = GetRoot()
                        if root then
                            local ok, pivot = pcall(function()
                                return target:GetPivot()
                            end)
                            if ok and pivot then
                                root.CFrame = pivot + Vector3.new(0, 3, 0)
                            end
                        end
                    end
                    task.wait(0.15)
                end
                if #targets == 0 then task.wait(1) end
            end
        end
    end)
end

