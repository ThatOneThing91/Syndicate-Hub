                                    attempts += 1
                                    local ok
                                    if typeof(fireproximityprompt) == "\102\117\110\099\116\105\111\110" then
                                        ok = pcall(fireproximityprompt, prompt)
                                    else
                                        ok = pcall(function()
                                            prompt:InputHoldBegin()
                                            task.wait(math.max(prompt.HoldDuration, 0.05))
                                            prompt:InputHoldEnd()
                                        end)
                                    end
                                    if not ok then break end
                                    task.wait(0.20)
                                end
                                harvestFailures[garden] = os.clock() + 0.7
                            end
                        end
                    end
                end
                task.wait(any and 0.12 or 0.5)
            end
        end)
    end

