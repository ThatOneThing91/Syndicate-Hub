ThisHubInstance.ScanFarmAuctions = function(areaName, force)
    local now = os.clock()
    local cached = ThisHubInstance.AuctionSnapshots[areaName]
    if not force and cached and now - cached.at < 1 then return cached end
    local auctions = AreaAuctions[areaName] or {}
    local snapshot = {at = now, entries = {}, byName = {}}
    local prices = ThisHubInstance.AuctionPriceHistory[areaName] or {}
    local kinds = ThisHubInstance.AuctionPriceKinds[areaName] or {}
    ThisHubInstance.AuctionPriceHistory[areaName] = prices
    ThisHubInstance.AuctionPriceKinds[areaName] = kinds
    for index, name in ipairs(auctions) do
        local fixedPrice, fixedKind = ThisHubInstance.GetKnownAuctionRequirement(areaName, name)
        local displayPrice = fixedPrice
        if displayPrice == nil then displayPrice = prices[name] end
        snapshot.byName[name] = {name = name, index = index, spawned = 0,
            price = displayPrice,
            kind = fixedKind or kinds[name], fixedRequirement = fixedPrice ~= nil}
    end
    local cash, worth = GetPlayerMoney(), ThisHubInstance.GetPlayerAuctionNetWorth()
    local seen = {}
    local function inspect(garage)
        local row = snapshot.byName[garage.Name]
        if not row or seen[garage] then return end
        seen[garage] = true
        row.spawned = row.spawned + 1
        local price, kind = ThisHubInstance.GetKnownAuctionRequirement(areaName, row.name)
        if price == nil then price, kind = GetGaragePrice(garage) end
        if price ~= nil then
            prices[row.name], kinds[row.name] = price, kind
            row.price, row.kind, row.priceObserved = price, kind, true
        end
        local available = ThisHubInstance.IsFarmGarageAvailable(garage)
        local gate = kind == "\110\101\116\119\111\114\116\104" and price or ThisHubInstance.GetGarageAuctionNetWorth(garage)
        if kind == "\099\097\110\100\121" then gate = nil end
        local worthBlocked = gate ~= nil and worth ~= nil and worth < gate
        local affordable = not worthBlocked and (kind == "\099\097\110\100\121" or ThisHubInstance.CheckAuctionFunds(price, kind, cash, worth))
        if available then
            row.enterable = true
            if worthBlocked then row.worthBlocked = true end
            if affordable then row.affordable = true end
        end
        snapshot.entries[#snapshot.entries + 1] = {
            name = row.name, index = row.index, garage = garage,
            price = price ~= nil and price or prices[row.name], kind = kind or kinds[row.name],
            available = available, affordable = affordable}
    end
    local garages = GetGaragesFolder()
    if garages then
        for _, garage in ipairs(garages:GetChildren()) do inspect(garage) end
    end
    local areas = workspace:FindFirstChild("\065\114\101\097\115")
    local area = areas and areas:FindFirstChild(areaName)
    if area then
        for index, garage in ipairs(area:GetDescendants()) do
            inspect(garage)
            if index % 500 == 0 then task.wait() end
        end
    end
                                                                      
    local movingAreaName = areaName == "\067\097\114\103\111\032\084\114\097\105\110" and "\067\097\114\103\111\084\114\097\105\110\083\116\111\112"
        or (areaName == "\067\097\114\103\111\032\083\104\105\112" and "\067\097\114\103\111\083\104\105\112")
    local movingArea = movingAreaName and workspace:FindFirstChild(movingAreaName)
    if movingArea then
        for index, object in ipairs(movingArea:GetDescendants()) do
            if snapshot.byName[object.Name] then inspect(object) end
            if index % 500 == 0 then task.wait() end
        end
    end
    ThisHubInstance.AuctionSnapshots[areaName] = snapshot
    return snapshot
end

ThisHubInstance.FindFarmableAuction = function(areaName, excludedGarage)
    local now = os.clock()
    local selectedName = State.SelectedAuction
                                                                              
                                                                              
    local snapshot = ThisHubInstance.ScanFarmAuctions(areaName, true)
    local candidates = {}
    for _, candidate in ipairs(snapshot.entries) do
        if candidate.garage ~= excludedGarage
            and candidate.available
            and candidate.affordable
            and ThisHubInstance.IsFarmGarageAvailable(candidate.garage)
            and not WasNetWorthRejected(areaName, candidate.name)
            and (candidate.name == selectedName
                or now >= (ThisHubInstance.FarmEntryRetryAfter[candidate.garage] or 0)) then
            candidates[#candidates + 1] = candidate
        end
    end

    table.sort(candidates, function(left, right)
        local leftSelected = left.name == selectedName
        local rightSelected = right.name == selectedName
        if leftSelected ~= rightSelected then return leftSelected end
        if left.price ~= nil and right.price ~= nil and left.price ~= right.price then
            return left.price > right.price
        end
        if (left.price ~= nil) ~= (right.price ~= nil) then
            return left.price ~= nil
        end
        return left.index > right.index
    end)

    local best = candidates[1]
    if best and best.name == selectedName then
        ThisHubInstance.SelectedTierRetryArea = nil
        ThisHubInstance.SelectedTierRetryName = nil
        ThisHubInstance.SelectedTierRetryUntil = 0
        ThisHubInstance.FarmFallbackMissingSince[areaName] = nil
        return best.name, best.garage
    end

                                                                                
    if ThisHubInstance.SelectedTierRetryArea == areaName
        and ThisHubInstance.SelectedTierRetryName == selectedName
        and now < (ThisHubInstance.SelectedTierRetryUntil or 0) then
        return nil, nil
    end
                                                                             
                                                                                  
    local missing = ThisHubInstance.FarmFallbackMissingSince[areaName]
    if not missing or missing.name ~= selectedName then
        ThisHubInstance.FarmFallbackMissingSince[areaName] = {name = selectedName, at = now}
        return nil, nil
    end
    if now - missing.at < 0.8 then return nil, nil end
    return best and best.name, best and best.garage
end

ThisHubInstance.FormatAuctionOption = function(name)
    local areaName = State.SelectedArea
    local snapshot = ThisHubInstance.AuctionSnapshots[areaName]
    local row = snapshot and snapshot.byName[name]
    local price = row and row.price
    if price == nil then return tostring(name) end
    local digits = string.format("\037\046\048\102", math.floor(price))
    digits = digits:reverse():gsub("\040\037\100\037\100\037\100\041", "\037\049\044"):reverse():gsub("\094\044", "")
    if price % 1 ~= 0 then digits = digits .. string.format("\037\046\050\102", price % 1):sub(2) end
    local amount = (row.kind == "\099\097\110\100\121" and "" or "\036") .. digits
        .. (row.kind == "\099\097\110\100\121" and "\032\099\097\110\100\121" or "")
    return tostring(name) .. "\032\040" .. amount .. "\041"
end

