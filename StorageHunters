local function WasNetWorthRejected(areaName, garageName)
    local key = GarageRejectKey(areaName, garageName)
    local rejected = NetWorthRejectedGarages[key]
    if type(rejected) == "\116\097\098\108\101" and rejected.minimum then
        local worth = ThisHubInstance.GetPlayerAuctionNetWorth()
        if worth and worth >= rejected.minimum then
            NetWorthRejectedGarages[key] = nil
            return false
        end
    end
    return rejected ~= nil and rejected ~= false
end

local function MarkNetWorthRejected(areaName, garageName, minimum)
    if not areaName or not garageName then
        return
    end

    NetWorthRejectedGarages[
        GarageRejectKey(areaName, garageName)
    ] = {minimum = minimum}
end

                                                                          
                                                                            
