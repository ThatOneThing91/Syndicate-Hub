    end

    PendingGarageEntry = {
        Area = areaName,
        Name = garageName,
        Garage = garage,
        RunId = runId,
    }

                                                                        
                                                                              
                                                                               
    FarmingBidGarage = garage
    FarmingBidRunId = runId

    local started = false
    local lastPromptAttempt = -math.huge
    local missingSince = nil
    local PROMPT_CONFIRM_WINDOW = 1.25

    while not HubDestroyed
        and State.Farming
        and RunIds.Farming == runId do

        if WasNetWorthRejected(areaName, garageName) then
            PendingGarageEntry = nil
            FarmingBidGarage = nil
            return "\117\110\097\102\102\111\114\100\097\098\108\101"
        end

                                                                                
                                                                         
        if ThisHubInstance.ActiveAuctionAreaOpen then
