-- Manual unload uses the rate badge; automatic unload uses actual cargo weight.
do
    State.AutoUnloadWhenFull = false
    local serial, busy, fullLatched = 0, false, nil
    local function cleanName(value)
        return tostring(value or ""):gsub("<[^>]*>", ""):gsub("^%s*@?", ""):gsub("%s*$", ""):lower()
    end
    local function ownPlot()
        local plots = workspace:FindFirstChild("_Plots")
        if not plots then return nil, "_Plots is missing" end
        local found, named, count = nil, nil, 0
        local displayMatches = 0
        for _, plot in ipairs(plots:GetChildren()) do
            count = count + 1
            local owner = tonumber(plot:GetAttribute("OwnerUserId") or plot:GetAttribute("OwnerUserID"))
            local head = plot:FindFirstChild("OwnerHeadshot")
            local label = head and head:FindFirstChild("OwnerName", true)
            local name = ""
            if label then
                if label:IsA("StringValue") then name = label.Value
                elseif label:IsA("TextLabel") or label:IsA("TextButton") then name = label.Text end
            end
            name = cleanName(name)
            local matches = owner == LocalPlayer.UserId
                or ((not owner or owner == 0) and name == cleanName(LocalPlayer.Name))
            if matches then
                if found then return nil, "multiple plots match your account" end
                found = plot
            elseif (not owner or owner == 0) and name ~= ""
                and name == cleanName(LocalPlayer.DisplayName) then
                named = plot
                displayMatches = displayMatches + 1
            end
        end
        if found then return found end
        -- A display name is accepted only when it uniquely identifies a plot.
        if displayMatches == 1 then return named end
        return nil, tostring(count) .. " plots checked; no unique owner match for @" .. LocalPlayer.Name
    end
    local function padFor(plot, humanoid, vehicle)
        local zone = plot:FindFirstChild("UnpackZone", true)
        local pad = zone and zone:FindFirstChild("Pad")
        if pad and pad:IsA("BasePart") then return pad end
        zone = workspace:FindFirstChild("UnpackZone")
        pad = zone and zone:FindFirstChild("Pad")
        if not pad or not pad:IsA("BasePart") then return nil end
        local zoneOwner = tonumber(zone:GetAttribute("OwnerUserId"))
        local padOwner = tonumber(pad:GetAttribute("OwnerUserId"))
        if (zoneOwner and zoneOwner ~= 0 and zoneOwner ~= LocalPlayer.UserId)
            or (padOwner and padOwner ~= 0 and padOwner ~= LocalPlayer.UserId) then
            error("The unpack zone explicitly belongs to another player.")
        end
        -- This pad lives outside _Plots and can be created by the local
        -- vehicle UI. Resolve it only in our equipped vehicle's driver seat.
        -- Its distance from plot geometry is not an ownership signal.
        local seat = humanoid.SeatPart
        if ownPlot() == plot and seat and vehicle
            and seat:IsA("VehicleSeat") and seat:IsDescendantOf(vehicle) then
            return pad
        end
        return nil
    end
    local function plotArrival(plot)
        for _, name in ipairs({"VehicleSpawn", "Driveway", "SpawnLocation", "PlotBase", "Ground", "Floor", "Base"}) do
            local part = plot:FindFirstChild(name, true)
            if part and part:IsA("BasePart") and part.Size.X >= 6 and part.Size.Z >= 6 then
                return part.CFrame * CFrame.new(0, part.Size.Y / 2 + 4, 0)
            end
        end
        -- Plots may be Folders, which have no GetPivot method.
        local floor
        for _, part in ipairs(plot:GetDescendants()) do
            if part:IsA("BasePart") and part.Anchored and part.CanCollide
                and part.Size.X >= 12 and part.Size.Z >= 12
                and part.Size.Y <= math.min(part.Size.X, part.Size.Z) / 2
                and not part:GetAttribute("IsStockDecor") then
                if not floor or part.Position.Y - part.Size.Y / 2
                    < floor.Position.Y - floor.Size.Y / 2 then floor = part end
            end
        end
        if floor then return floor.CFrame * CFrame.new(0, floor.Size.Y / 2 + 4, 0) end
        if plot:IsA("Model") or plot:IsA("BasePart") then
            return plot:GetPivot() * CFrame.new(0, 5, 0)
        end
        error("No floor or spawn position found in your " .. plot.ClassName .. " plot.")
    end
    local function equippedVehicle(guid)
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("Model") and
                tostring(object:GetAttribute("VehicleGUID") or object:GetAttribute("GUID") or "") == guid then
                return object
            end
        end
    end
    ThisHubInstance.GoToUnload = function(automatic)
        if HubDestroyed then return false end
        if busy then Notify("Unload", "An unload trip is already running.", 3); return false end
        busy = true
        serial = serial + 1
        local run = serial
        local function active()
            return not HubDestroyed and serial == run
                and (not automatic or State.AutoUnloadWhenFull)
        end
        local step = "1/6 Find your plot"
        local function progress(value)
            step = value
            print("[Syndicate Unload] " .. value)
            if ThisHubInstance.UnloadStatusLabel and ThisHubInstance.UnloadStatusLabel.Parent then
                ThisHubInstance.UnloadStatusLabel.Text = "" .. value
            end
        end
        progress(step)
        Notify("Unload", "Starting unload trip: finding your plot.", 3)
        local ok, failure = pcall(function()
            local plot, reason = ownPlot()
            if not plot then error("Plot detection failed: " .. tostring(reason)) end
            local pad
            local guid = LocalPlayer:GetAttribute("EquippedVehicle")
            if type(guid) ~= "string" or guid == "" then error("Equip your vehicle first.") end
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if not humanoid or not root or humanoid.Health <= 0 then error("Wait for your character to load.") end
            local function check()
                if not active() then error("Unload cancelled.") end
                if LocalPlayer.Character ~= character or humanoid.Health <= 0 then error("Character changed; tap again.") end
                if ownPlot() ~= plot then error("Your plot changed; unload stopped.") end
                if LocalPlayer:GetAttribute("EquippedVehicle") ~= guid then error("Your equipped vehicle changed; unload stopped.") end
            end
            local events = ReplicatedStorage:FindFirstChild("Events")
            local vehicles = events and events:FindFirstChild("Vehicles")
            local spawn = vehicles and vehicles:FindFirstChild("RequestSpawn")
            if not spawn or not spawn:IsA("RemoteEvent") then error("Vehicle spawn remote unavailable.") end
            check()
            -- Stop auction teleports before moving to the unloading pad.
            if State.Farming then
                State.Farming = false
                RunIds.Farming += 1
                ThisHubInstance.StopFarmingWorkers()
                if ToggleObjects.Farming then ToggleObjects.Farming(false) end
            end
            -- Preserve Instant Unload and its running worker during unload trips.
            progress("2/6 Prepare your vehicle")
            local vehicle = equippedVehicle(guid)
            local seat = vehicle and vehicle:FindFirstChildWhichIsA("VehicleSeat", true)
            local alreadySeated = seat and humanoid.SeatPart == seat
            local deadline
            if not alreadySeated then
                deadline = os.clock() + 3
                while humanoid.SeatPart do
                    check()
                    humanoid.Sit = false
                    humanoid.Jump = true
                    task.wait(0.1)
                    if os.clock() >= deadline then error("Could not leave your current seat.") end
                end
                check()
                progress("3/6 Travel to " .. plot.Name)
                root.CFrame = plotArrival(plot)
                root.AssemblyLinearVelocity = Vector3.zero
                local arrival = root.Position
                task.wait(0.5)
                check()
                local spawnFailure
                local connection
                local result = vehicles:FindFirstChild("SpawnResult")
                if result and result:IsA("RemoteEvent") then
                    connection = result.OnClientEvent:Connect(function(success, message)
                        if success == false then spawnFailure = tostring(message or "Spawn rejected.") end
                    end)
                end
                progress("4/6 Request vehicle spawn")
                Notify("Unload", "At your plot; requesting your vehicle.", 3)
                local requested, spawnError = pcall(function() spawn:FireServer(guid) end)
                vehicle, seat = nil, nil
                deadline = os.clock() + 12
                repeat
                    if not active() or LocalPlayer.Character ~= character or ownPlot() ~= plot then break end
                    if spawnFailure or not requested then break end
                    vehicle = equippedVehicle(guid)
                    if vehicle then
                        seat = vehicle:FindFirstChildWhichIsA("VehicleSeat", true)
                        if seat and (seat.Position - arrival).Magnitude <= 70 then break end
                        seat = nil
                    end
                    task.wait(0.15)
                until os.clock() >= deadline
                if connection then connection:Disconnect() end
                check()
                if not requested then error(tostring(spawnError)) end
                if spawnFailure then error("Vehicle spawn failed: " .. spawnFailure) end
                if not seat then error("Your vehicle did not spawn near your plot with a driver seat.") end
            end
            progress("5/6 Sit in your vehicle")
            deadline = os.clock() + 5
            repeat
                check()
                if not seat.Parent then error("Vehicle disappeared; tap again.") end
                if seat.Occupant and seat.Occupant ~= humanoid then error("Your driver seat is occupied.") end
                if humanoid.SeatPart == seat then break end
                root.CFrame = seat.CFrame * CFrame.new(0, 2, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                seat:Sit(humanoid)
                task.wait(0.25)
            until os.clock() >= deadline
            check()
            if humanoid.SeatPart ~= seat then error("Could not sit in your vehicle; tap again.") end
            -- Wait for the zone to appear AFTER seating. Do not retain a
            -- pre-seat pad instance; the game can replace it on entry.
            progress("6/6 Wait for UnpackZone.Pad")
            deadline = os.clock() + 8
            repeat
                check()
                if humanoid.SeatPart ~= seat then error("You left the driver seat; tap again.") end
                pad = padFor(plot, humanoid, vehicle)
                if pad then break end
                task.wait(0.15)
            until os.clock() >= deadline
            if not pad then error("Seated in your vehicle, but workspace.UnpackZone.Pad did not appear.") end
            local bounds, size = vehicle:GetBoundingBox()
            local target = pad.Position + Vector3.new(0, pad.Size.Y / 2 + size.Y / 2 + 0.25, 0)
            vehicle:PivotTo(vehicle:GetPivot() + (target - bounds.Position))
            for _, part in ipairs(vehicle:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            progress("Ready at unloading pad")
            Notify("Unload", "Seated at the unloading pad. Check the game's unload menu.", 4)
        end)
        busy = false
        if not ok and active() then
            local message = step .. ": " .. tostring(failure)
            warn("[Syndicate Unload] " .. message)
            if ThisHubInstance.UnloadStatusLabel and ThisHubInstance.UnloadStatusLabel.Parent then
                ThisHubInstance.UnloadStatusLabel.Text = "" .. message
            end
            Notify("Unload stopped", message, 10)
        end
        return ok
    end
    ThisHubInstance.StartAutoUnloadWhenFull = function(enabled)
        serial = serial + 1
        fullLatched = nil
        if not enabled then return end
        local monitor = serial
        ThisHubInstance.AutoUnloadMonitor = monitor
        task.spawn(function()
            while not HubDestroyed and State.AutoUnloadWhenFull do
                -- GoToUnload changes serial; toggling OFF ends this worker.
                if ThisHubInstance.AutoUnloadMonitor ~= monitor then return end
                local guid = LocalPlayer:GetAttribute("EquippedVehicle")
                local vehicle = type(guid) == "string" and equippedVehicle(guid)
                local weight = vehicle and tonumber(vehicle:GetAttribute("CargoWeight"))
                local limit = vehicle and tonumber(vehicle:GetAttribute("CargoWeightLimit"))
                if weight and limit and limit > 0 then
                    if weight < limit then fullLatched = nil
                    elseif fullLatched ~= guid and not busy then
                        fullLatched = guid
                        ThisHubInstance.GoToUnload(true)
                    end
                end
                task.wait(1)
            end
        end)
    end
end

