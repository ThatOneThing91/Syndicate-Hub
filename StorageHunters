    local function onOutgoingPresented(id,offeredPercent,npc)
        if closed or not active or not uuid(id) then return end
        -- ShowOffer already carries verified prices and owns its queued reply.
        if eventOffers[id] then return end
        local n=tonumber(offeredPercent)
        local shopper=resolveShopper(npc)
        if typeof(npc)=="Instance" and not shopper then
            statusText.Text="Offer shopper no longer active"
            return
        end
        local ticket={}
        offerTickets[id]=ticket
        pendingIds[id]=os.clock()
        lastIncomingOfferAt=os.clock()
        outgoingCount=outgoingCount+1
        recentOutgoing={id=id,value=n,shopper=typeof(npc)=="Instance" and
            npc.Name or tostring(npc),at=os.clock()}
        local record="OUTGOING OfferPresented id="..id..
            " number="..tostring(n).." shopper="..recentOutgoing.shopper
        offerEventTraces[#offerEventTraces+1]=record
        if #offerEventTraces>16 then table.remove(offerEventTraces,1) end
        print("[Auto Shop Offers] "..record)
        -- Let the game's original FireServer finish before responding.
        -- Calling RespondOffer synchronously inside __namecall may race
        -- the server's creation of the offer.
        task.spawn(function()
            task.wait(.22)
            if closed or not active
                or offerTickets[id]~=ticket then return end
            local guiPct,guiGuid=offerPanelPercent()
            local finalPct,source=nil,nil
            if shopper and shopper.Parent then
                local sign=readGuiOffer(shopper)
                if sign and (not sign.id or sign.id==id) then
                    finalPct,source=sign.pct,"this shopper's sign"
                end
            end
            if finalPct~=nil then
                -- This sign belongs to the NPC in this exact event.
            elseif guiPct~=nil and guiGuid==id then
                finalPct=guiPct
                source="visible offer GUI"
            elseif percent<=-100 then
                finalPct=-100
                source="unconditional minimum threshold"
            else
                statusText.Text="Offer captured; waiting for this customer's %"
                return
            end
            if finalPct>=-100 and finalPct<=300 then
                statusText.Text="Offer "..tostring(math.floor(finalPct*10+.5)/10)..
                    "% ("..source..")"
                handleOffer(id,finalPct)
            else
                statusText.Text="Offer numeric value out of expected range"
            end
        end)
    end
    local function enableOutgoingCapture()
        if type(hookmetamethod)~="function" or
            type(getnamecallmethod)~="function" then
            outgoingStatus="executor has no namecall hook"
            return false
        end
        local events=ReplicatedStorage:FindFirstChild("Events")
        local shopper=events and events:FindFirstChild("NPCShopper")
        local presented=shopper and shopper:FindFirstChild("OfferPresented")
        if not presented or not presented:IsA("RemoteEvent") then
            outgoingStatus="OfferPresented remote unavailable"
            return false
        end
        local env=_G
        if type(getgenv)=="function" then
            local ok,value=pcall(getgenv)
            if ok and type(value)=="table" then env=value end
        end
        local key="__SyndicateShopOffersOutgoingV5"
        local entry=env[key]
        if type(entry)~="table" or not entry.installed then
            entry={installed=false,callback=nil,owner=nil}
            local original
            local function intercept(self,...)
                if self==entry.target then
                    local okay,method=pcall(getnamecallmethod)
                    if okay and method=="FireServer" then
                        local callback=entry.callback
                        if callback then pcall(callback,...) end
                    end
                end
                return original(self,...)
            end
            local wrapper=intercept
            if type(newcclosure)=="function" then
                local ok,wrapped=pcall(newcclosure,intercept)
                if ok then wrapper=wrapped end
            end
