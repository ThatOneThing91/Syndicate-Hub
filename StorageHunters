-- Syndicate Hub protected loader
local RELEASE='4.0'
local Players=game:GetService('Players')
local HttpService=game:GetService('HttpService')
local StarterGui=game:GetService('StarterGui')
local player=Players.LocalPlayer
if not player then return end

local function notify(text)
 pcall(function()
  StarterGui:SetCore('SendNotification',{Title='Syndicate Hub',Text=tostring(text),Duration=8})
 end)
end

local function loadKeyGate()
 local source=game:HttpGet('https://raw.githubusercontent.com/ThatOneThing91/Syndicate-Hub/main/auth/KeyGate.lua?v='..tostring(os.time()))
 local chunk,err=loadstring(source)
 assert(chunk,err or 'Key menu failed to compile')
 return chunk()
end

local ok,KeySession=pcall(loadKeyGate)
if not ok then notify('Key menu failed to load: '..tostring(KeySession));return end
if type(KeySession)~='table' or type(KeySession.key)~='string' then return end

local send=request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
if type(send)~='function' then notify('This executor does not support protected script delivery.');return end

local responseOK,response=pcall(send,{
 Url='https://syndicate-script.loganmatthewsmall.workers.dev/load',
 Method='POST',
 Headers={['Content-Type']='application/json',['Cache-Control']='no-store'},
 Body=HttpService:JSONEncode({key=KeySession.key,userId=tostring(player.UserId),release=RELEASE}),
})
if not responseOK or type(response)~='table' then
 notify('Protected script delivery is unavailable. Please try again.')
 return
end
local status=tonumber(response.StatusCode or response.Status)
if status~=200 then
 notify(status==403 and 'Your Syndicate key is not authorized.' or 'Protected script delivery failed. Please try again.')
 return
end

local decodedOK,data=pcall(function() return HttpService:JSONDecode(response.Body or '') end)
if not decodedOK or type(data)~='table' or type(data.payload)~='string' or type(data.nonce)~='string' then
 notify('Protected script response was invalid.')
 return
end

local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local lookup={}
for i=1,#alphabet do lookup[alphabet:sub(i,i)]=i-1 end
local function decode64(value)
 value=value:gsub('[^A-Za-z0-9%+/%=]','')
 local out=table.create(math.floor(#value*3/4))
 local oi=0
 for i=1,#value,4 do
  local a=lookup[value:sub(i,i)] or 0
  local b=lookup[value:sub(i+1,i+1)] or 0
  local c=value:sub(i+2,i+2)=='=' and 0 or (lookup[value:sub(i+2,i+2)] or 0)
  local d=value:sub(i+3,i+3)=='=' and 0 or (lookup[value:sub(i+3,i+3)] or 0)
  local n=a*262144+b*4096+c*64+d
  oi+=1;out[oi]=string.char(math.floor(n/65536)%256)
  if value:sub(i+2,i+2)~='=' then oi+=1;out[oi]=string.char(math.floor(n/256)%256) end
  if value:sub(i+3,i+3)~='=' then oi+=1;out[oi]=string.char(n%256) end
 end
 return table.concat(out, '', 1, oi)
end

local function rc4(cipher,key)
 local s={}
 for i=0,255 do s[i]=i end
 local j=0
 for i=0,255 do
  j=(j+s[i]+key:byte((i%#key)+1))%256
  s[i],s[j]=s[j],s[i]
 end
 local out=table.create(#cipher)
 local i=0;j=0
 for n=1,#cipher do
  i=(i+1)%256
  j=(j+s[i])%256
  s[i],s[j]=s[j],s[i]
  local k=s[(s[i]+s[j])%256]
  out[n]=string.char(bit32.bxor(cipher:byte(n),k))
 end
 return table.concat(out)
end

local payload
local decryptOK,decryptError=pcall(function()
 payload=rc4(decode64(data.payload),KeySession.key..':'..data.nonce)
end)
if not decryptOK or type(payload)~='string' then
 notify('Protected script could not be decrypted: '..tostring(decryptError))
 return
end

local env=getgenv and getgenv() or _G
env.__SyndicateProtectedSession=KeySession
local chunk,compileError=loadstring(payload)
if not chunk then
 env.__SyndicateProtectedSession=nil
 notify('Protected Syndicate Hub failed to compile: '..tostring(compileError))
 return
end
local runOK,runError=pcall(chunk)
env.__SyndicateProtectedSession=nil
if not runOK then notify('Syndicate Hub stopped during startup: '..tostring(runError)) end
