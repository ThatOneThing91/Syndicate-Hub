local function FishStep(runId)
    local now = os.clock()
    if FishPhase == "\105\100\108\101" then
        if FishSessionLocked or FishGetReelGui() then
            FishSessionLocked = true
            FishSetPhase("\114\101\101\108\105\110\103")
            return
        end
        FishSetPhase("\101\113\117\105\112\112\105\110\103")
        local ready = FishEnsureRod(runId)
        if not FishActive(runId) then return end
        if not ready then FishSetPhase("\114\111\100\095\114\101\116\114\121") return end
        local water, position = FishFindWater()
        if not water then FishSetPhase("\115\101\097\114\099\104\105\110\103") return end
                                                                                
        FishCastId = nil
        FishSessionLocked = true
        FishSetPhase("\099\097\115\116\105\110\103")
        local sent = pcall(function() FishCast:FireServer(water, position) end)
        if not sent then
                                                                           
            FishSetPhase("\114\101\099\111\118\101\114\105\110\103")
        end
    elseif FishPhase == "\114\111\100\095\114\101\116\114\121" then
        if now - FishPhaseAt >= 3 then
            FishInventoryCache = nil
            FishSetPhase("\105\100\108\101")
        end
    elseif FishPhase == "\115\101\097\114\099\104\105\110\103" then
        if now - FishPhaseAt >= 1 then FishSetPhase("\105\100\108\101") end
    elseif FishPhase == "\099\097\115\116\105\110\103" then
        if now - FishPhaseAt > 12 then
                                                                                    
            FishSetPhase("\114\101\099\111\118\101\114\105\110\103")
        end
    elseif FishPhase == "\119\097\105\116\105\110\103" then
        if now - FishPhaseAt > 45 then
                                                                          
            FishSetPhase("\114\101\099\111\118\101\114\105\110\103")
        end
    elseif FishPhase == "\114\101\099\111\118\101\114\105\110\103" then
                                                                             
        if FishGetReelGui() then
            FishSetPhase("\114\101\101\108\105\110\103")
        end
    elseif FishPhase == "\114\101\101\108\105\110\103" then
                                                                                      
                                                                  
                                                      
                                                                    
    elseif FishPhase == "\102\105\110\105\115\104\105\110\103" then
        FishRelease()
        if now - FishPhaseAt >= 1.8 and not FishSessionLocked and not FishGetReelGui() then
            FishResetTracking()
            FishSetPhase("\105\100\108\101")
        end
    end
end

local function FishStart(runId)
    task.spawn(function()
        while FishActive(runId) do
                                                                                  
                                                                                    
            local guiVisible = FishGetReelGui() ~= nil
            if guiVisible then
                FishSessionLocked = true
                if FishPhase ~= "\114\101\101\108\105\110\103" then
                    FishSetPhase("\114\101\101\108\105\110\103")
                end
            end

                                                                           
            if FishSessionLocked or guiVisible then
                local ok, err = pcall(FishTrack)
                if not ok then
                    FishTrackingErrors += 1
                    if FishTrackingErrors == 1 or FishTrackingErrors % 30 == 0 then
                        warn("\091\065\117\116\111\032\070\105\115\104\105\110\103\093\032\084\114\097\099\107\105\110\103\032\101\114\114\111\114\032\040\114\101\116\114\121\105\110\103\041\058", err)
                    end
                                                                            
                    FishGuiObjects = nil
                    FishLastSample = nil
                else
                    FishTrackingErrors = 0
                end
            end

            local ok, err = pcall(FishStep, runId)
            if not ok then
                warn("\091\065\117\116\111\032\070\105\115\104\105\110\103\093\032\083\116\097\116\101\032\101\114\114\111\114\032\040\114\101\116\114\121\105\110\103\032\119\105\116\104\111\117\116\032\114\101\099\097\115\116\041\058", err)
                                                                              
                                                                                  
                FishSessionLocked = true
                if FishGetReelGui() then
                    FishSetPhase("\114\101\101\108\105\110\103")
                else
                    FishSetPhase("\114\101\099\111\118\101\114\105\110\103")
                end
            end
            task.wait(0.016)
        end
        if RunIds.Fishing == runId then FishRelease() end
    end)
end

