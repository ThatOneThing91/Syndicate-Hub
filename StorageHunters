end

local function waitForEmpty(slot)
    for check = 1, 6 do
        if not alive or not enabled or HubDestroyed then return false end
        if verifyEmpty(slot) then return true end
        if check < 6 then task.wait(0.25) end
    end
    return false
end

local function handleOccupied(slot, info)
    local itemKey = tostring(info.ItemGUID or info.itemGUID or info.Guid or info.guid or "unknown")
    local progress = slotCollection[slot]
    if not progress or (itemKey ~= "unknown" and progress.itemKey ~= itemKey) then
        progress = {
            itemKey = itemKey,
            phase = "reveal",
            collectLast = -100,
            claimLast = -100,
            collectFailures = 0,
            claimFailures = 0,
            claimAfter = 0
        }
        slotCollection[slot] = progress
    end

    local remaining = remainingTime(info)
    if remaining == nil and progress.phase ~= "claim" then
        if attemptAllowed("unknown_" .. slot, 12) then
            report("Slot " .. slot .. ": unknown timer/state")
        end
        return "Unknown"
    end
    if remaining and remaining > 0 then
        return tostring(math.ceil(remaining)) .. "s"
    end

    if progress.phase == "reveal" then
        if os.clock() - progress.collectLast < 1.6 then return "Reveal retry" end
        progress.collectLast = os.clock()
        local ok, result = invoke("CollectGrade", slot)

        if gradingActionRejected(ok, result) then
            progress.collectFailures += 1
            local reason = gradingActionReason(result)
            if progress.collectFailures >= 2 then
                -- If already revealed, a claim may work even when reveal now fails.
                progress.phase = "claim"
                progress.claimAfter = os.clock() + 0.65
                report("Slot " .. slot .. ": reveal unconfirmed; checking claim")
            else
                report("Slot " .. slot .. ": reveal retry" .. (reason and (" - " .. tostring(reason)) or ""))
                return "Reveal retry"
            end
        else
            progress.phase = "claim"
            progress.claimAfter = os.clock() + 0.9
            report("Slot " .. slot .. ": reveal accepted")
        end
    end

    if not enabled or not alive or HubDestroyed then return "Paused" end
    local claimWait = progress.claimAfter - os.clock()
    if claimWait > 0 then task.wait(claimWait) end
    if not enabled or not alive or HubDestroyed then return "Paused" end
    if os.clock() - progress.claimLast < 1.5 then return "Claim retry" end

    progress.claimLast = os.clock()
    local ok, result = invoke("ClaimGradedItem", slot)
    if gradingActionRejected(ok, result) then
        progress.claimFailures += 1
        local reason = gradingActionReason(result)
        report("Slot " .. slot .. ": claim retry" .. (reason and (" - " .. tostring(reason)) or ""))

        if progress.claimFailures >= 4 then
            -- Re-sync only after multiple rejected claims, not on every pass.
            progress.phase = "reveal"
            progress.claimFailures = 0
            progress.collectFailures = 0
            report("Slot " .. slot .. ": rechecking reveal state")
        end
        return "Claim retry"
    end

    if waitForEmpty(slot) then
        slotCollection[slot] = nil
        report("Slot " .. slot .. ": cleared successfully")
        return "Empty"
    end

    -- Slot-state replication can lag behind the accepted claim.
    return "Awaiting slot clear"
end

