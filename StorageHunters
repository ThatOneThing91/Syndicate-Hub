    end

    if not CanAffordGarage(garage) then
        return "\117\110\097\102\102\111\114\100\097\098\108\101"
    end

    if AuctionIsOpen() or ThisHubInstance.ActiveAuctionAreaOpen then
        ThisHubInstance.EnsureBidPosition()
        return "\097\117\099\116\105\111\110\095\097\099\116\105\118\101"
    end
    if not TeleportToGarage(garage) then
