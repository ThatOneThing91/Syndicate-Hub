local function FishEnsureRod(runId)
    local inventory = FishInventory()
    if not inventory then return false end
    local tool, id = FishEquipped()
    if tool then
        FishEquippedGuid = FishToolGuid(tool) or FishEquippedGuid
        local guid = FishEquippedGuid
        local item = FishInventoryItem(inventory, guid)
        local condition = tonumber(tool:GetAttribute("\067\111\110\100\105\116\105\111\110")
            or tool:GetAttribute("\068\117\114\097\098\105\108\105\116\121"))
        if item and FishIsRod(item, id) and not FishBroken(item)
            and tool:GetAttribute("\066\114\111\107\101\110") ~= true
            and tool:GetAttribute("\073\115\066\114\111\107\101\110") ~= true
            and (not condition or condition > 0) then
            return true
        end
    end

    local candidates = {}
    for key, item in pairs(inventory) do
        if type(item) == "\116\097\098\108\101" and FishIsRod(item, FishItemId(item))
            and not FishBroken(item) then
            local guid = item.Guid or item.GUID or item.UUID or key
            if type(guid) == "\115\116\114\105\110\103" then
                table.insert(candidates, {
                    guid = guid, id = FishItemId(item),
                    condition = tonumber(item.Condition) or 0
                })
            end
        end
    end
    table.sort(candidates, function(a,b) return a.condition > b.condition end)

    local oldGuid = tool and (FishToolGuid(tool) or FishEquippedGuid)
    for _, rod in ipairs(candidates) do
        if not FishActive(runId) then return false end
        if not oldGuid or rod.guid ~= oldGuid then
            local sent = pcall(function() FishEquip:FireServer(rod.guid) end)
            if sent then
                FishInventoryCache = nil
                local deadline = os.clock() + 3
                local nextCheck = 0
                while FishActive(runId) and os.clock() < deadline do
                    local equipped, equippedId = FishEquipped()
                    if equipped then
                        local equippedGuid = FishToolGuid(equipped)
                        local matches = equippedGuid == rod.guid
                            or (not equippedGuid and rod.id and equippedId == rod.id)
                        if matches and os.clock() >= nextCheck then
                            nextCheck = os.clock() + 0.75
                            local item = FishInventoryItem(FishInventory(true), rod.guid)
                            if item and not FishBroken(item) and FishIsRod(item, rod.id) then
                                FishEquippedGuid = rod.guid
                                return true
                            end
                        end
                    end
                    task.wait(0.20)
                end
            end
        end
    end
    return false
end

local function FishFindWater()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("\072\117\109\097\110\111\105\100\082\111\111\116\080\097\114\116")
    if not root then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false
    for _, distance in ipairs({45,40,50,35,55,30,25,20}) do
        for _, side in ipairs({0,-4,4,-8,8}) do
            local point = root.Position + root.CFrame.LookVector * distance
                + root.CFrame.RightVector * side
            local hit = workspace:Raycast(point + Vector3.new(0,35,0),
                Vector3.new(0,-110,0), params)
            if hit then
                local name = FishNormalize(hit.Instance.Name)
                if hit.Material == Enum.Material.Water
                    or name:find("\119\097\116\101\114",1,true) or name:find("\112\111\110\100",1,true)
                    or name:find("\108\097\107\101",1,true) or name:find("\114\105\118\101\114",1,true) then
                    return hit.Instance, hit.Position
                end
            end
        end
    end
end

