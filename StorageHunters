local function RepairContainsBroken(value, depth, visited)
    depth = depth or 0
    visited = visited or {}

    if depth > 8 or type(value) ~= "\116\097\098\108\101" or visited[value] then
        return false
    end

    visited[value] = true

    for key, data in pairs(value) do
        local keyLower = tostring(key):lower()

        if keyLower == "\098\114\111\107\101\110" and data == true then
            return true
        end

        if (keyLower == "\099\111\110\100\105\116\105\111\110" or keyLower == "\115\116\097\116\117\115" or keyLower == "\115\116\097\116\101")
            and type(data) == "\115\116\114\105\110\103"
            and data:lower() == "\098\114\111\107\101\110" then
            return true
        end

        if keyLower == "\109\117\116\097\116\111\114\115" and type(data) == "\116\097\098\108\101" then
            for mutatorName, mutatorValue in pairs(data) do
                if tostring(mutatorName):lower() == "\098\114\111\107\101\110" and mutatorValue ~= false then
                    return true
                end

                if type(mutatorValue) == "\115\116\114\105\110\103" and mutatorValue:lower() == "\098\114\111\107\101\110" then
                    return true
                end

                if type(mutatorValue) == "\116\097\098\108\101" then
                    local name = mutatorValue.Name
                        or mutatorValue.name
                        or mutatorValue.Mutator
                        or mutatorValue.mutator

                    if name and tostring(name):lower() == "\098\114\111\107\101\110" then
                        return true
                    end
                end
            end
        end

        if type(data) == "\116\097\098\108\101"
            and RepairContainsBroken(data, depth + 1, visited) then
            return true
        end
    end

    return false
end

                                                                         
                                                                          
local function FindBrokenRepairItem(runId)
    local inventory = GetRepairInventory()

    if type(inventory) ~= "\116\097\098\108\101" then
