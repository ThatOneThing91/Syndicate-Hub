    end

                                                                    
    local prompt = lostFound:FindFirstChild("\076\111\115\116\070\111\117\110\100\080\114\111\109\112\116", true)
    local destination

    if prompt and prompt.Parent and prompt.Parent:IsA("\066\097\115\101\080\097\114\116") then
        destination = prompt.Parent
    end

    if not destination then
        destination = lostFound:FindFirstChildWhichIsA("\066\097\115\101\080\097\114\116", true)
    end

    if not destination then
        return false
    end

                                                              
    root.CFrame = destination.CFrame + Vector3.new(0, 3, 0)

    return true
