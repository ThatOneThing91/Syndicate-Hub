            end
        end
        return fallback
    end

    local function PromptPosition(prompt)
        local parent = prompt.Parent
        if parent:IsA("\066\097\115\101\080\097\114\116") then return parent.Position end
        if parent:IsA("\065\116\116\097\099\104\109\101\110\116") then return parent.WorldPosition end
        local part = parent:FindFirstAncestorWhichIsA("\066\097\115\101\080\097\114\116")
        return part and part.Position
    end

    local function RunHarvest(id)
        task.spawn(function()
            while HarvestActive(id) do
