local function FarmGarage(garageName, areaName, runId, selectedGarage)
                                                                
                                                                       

    if HubDestroyed
        or not State.Farming
        or RunIds.Farming ~= runId then

        return "\115\116\111\112\112\101\100"
    end

    local garage = selectedGarage or GetGarageByNameForArea(areaName, garageName)
    local isFallback = garageName ~= State.SelectedAuction
    local selectedAtEntry = State.SelectedAuction

    local function SelectedGarageReady()
        if not isFallback then
            return nil
        end

        local selectedName, selected = ThisHubInstance.FindFarmableAuction(areaName)
        if selectedName == State.SelectedAuction and selected and selected ~= garage then
            return selectedName, selected
        end

        return nil
    end

    local committed = ThisHubInstance.FarmEntryTarget
    if not (committed and committed.garage == garage)
        and not ThisHubInstance.IsFarmGarageAvailable(garage) then
        return "\117\110\097\118\097\105\108\097\098\108\101"
    end

                                                                           
                                                                     
    if isFallback and SelectedGarageReady() then
        ThisHubInstance.AuctionSnapshots[areaName] = nil
