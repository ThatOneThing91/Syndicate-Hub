local function FishBroken(item)
    if type(item) ~= "\116\097\098\108\101" then return false end
    if item.Broken == true or item.IsBroken == true
        or FishNormalize(item.Status) == "\098\114\111\107\101\110" then return true end
    local condition = tonumber(item.Condition or item.Durability)
    if condition and condition <= 0 then return true end
    for key, value in pairs(item.Mutators or {}) do
        if FishNormalize(key) == "\098\114\111\107\101\110" and value ~= false then return true end
        if FishNormalize(value) == "\098\114\111\107\101\110" then return true end
        if type(value) == "\116\097\098\108\101" and
            FishNormalize(value.Name or value.name or value.Mutator) == "\098\114\111\107\101\110" then
            return true
        end
    end
    return false
end

