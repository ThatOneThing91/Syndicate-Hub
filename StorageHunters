local FishControlLastMotion = 0
local FishControlLastPulse = 0
local FishControlLastPosition = nil

local function FishTrack()
    local now = os.clock()
    if now < FishNextStep then return end
    FishNextStep = now + 0.016
    local bar, fish, zone = FishGetReelGui()
    if not bar then
                                                                         
                                                                         
        if now - FishLastGuiSeen > 0.4 then
            FishRelease()
            FishGuiObjects = nil
            FishLastSample = nil
            FishControlLastPosition = nil
        end
        return
    end
    FishLastGuiSeen = now
    if not FishGuiObjects or FishGuiObjects.fish ~= fish or FishGuiObjects.zone ~= zone then
        FishLastX, FishLastZoneX, FishLastSample = nil, nil, nil
        FishVelocity, FishZoneVelocity = 0, 0
        FishControlLastPosition = nil
        FishControlLastMotion = now
        FishGuiObjects = {fish = fish, zone = zone}
    end
    local width = math.max(bar.AbsoluteSize.X, 1)
    local origin = bar.AbsolutePosition.X
    local x = (fish.AbsolutePosition.X + fish.AbsoluteSize.X * 0.5 - origin) / width
    local z = (zone.AbsolutePosition.X + zone.AbsoluteSize.X * 0.5 - origin) / width
    local dt = FishLastSample and math.clamp(now - FishLastSample, 0.016, 0.12) or 0.04
    if FishLastX then
        local v = math.clamp((x - FishLastX) / dt, -2, 2)
        FishVelocity = FishVelocity * 0.55 + v * 0.45
    end
    if FishLastZoneX then
        local v = math.clamp((z - FishLastZoneX) / dt, -2, 2)
        FishZoneVelocity = FishZoneVelocity * 0.55 + v * 0.45
    end
    FishLastX, FishLastZoneX, FishLastSample = x, z, now

                                                                         
    local target = math.clamp(x + FishVelocity * 0.055, 0, 1)
    local control = target - z - FishZoneVelocity * 0.022
    local desired = FishMouseHeld and control > -0.014 or control > 0.014

                                                                       
                                                                          
    if FishControlLastPosition == nil or math.abs(z - FishControlLastPosition) > 0.002 then
        FishControlLastMotion = now
        FishControlLastPosition = z
    elseif FishMouseHeld and control > 0.045
        and now - FishControlLastMotion > 0.65
        and now - FishControlLastPulse > 0.85 then
        FishInput(false)
        FishMouseHeld = false
        FishLastSwitch = 0
        FishControlLastPulse = now
        FishControlLastMotion = now
    end
    FishSetMouse(desired, now)
end

