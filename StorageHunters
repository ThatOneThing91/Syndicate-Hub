local function IsVehicleFull()
    local vehicle = GetMyVehicle()
    if not vehicle then
        return false
    end

    local weight = tonumber(vehicle:GetAttribute("\067\097\114\103\111\087\101\105\103\104\116")) or 0
    local limit = tonumber(vehicle:GetAttribute("\067\097\114\103\111\087\101\105\103\104\116\076\105\109\105\116")) or 0

    if limit > 0 and weight >= limit then
        return true, weight, limit
    end

                                                          
    local vehicleId =
        vehicle:GetAttribute("\086\101\104\105\099\108\101\071\085\073\068")
        or vehicle:GetAttribute("\071\085\073\068")
        or LocalPlayer:GetAttribute("\069\113\117\105\112\112\101\100\086\101\104\105\099\108\101")

    local events = ReplicatedStorage:FindFirstChild("\069\118\101\110\116\115")
    local vehicleEvents = events and events:FindFirstChild("\086\101\104\105\099\108\101\115")
    local getItems = vehicleEvents and vehicleEvents:FindFirstChild("\071\101\116\086\101\104\105\099\108\101\073\116\101\109\115")

    -- Never block the shutdown monitor on a server InvokeServer response.
    local cache = ThisHubInstance.FarmCapacityCache
    if cache and cache.vehicle == vehicle and os.clock() - cache.at < 3
        and cache.full then return true end
    if vehicleId and getItems and getItems:IsA("\082\101\109\111\116\101\070\117\110\099\116\105\111\110")
        and not ThisHubInstance.FarmCapacityQuery
        and (not cache or cache.vehicle ~= vehicle or os.clock() - cache.at >= 1) then
        local ticket = {}
        local runId = RunIds.Farming
        ThisHubInstance.FarmCapacityQuery = ticket
        ThisHubInstance.FarmingCapacityThread = task.defer(function()
            local ok, result = pcall(function() return getItems:InvokeServer(vehicleId) end)
            if ThisHubInstance.FarmCapacityQuery ~= ticket then return end
            ThisHubInstance.FarmCapacityQuery = nil
            ThisHubInstance.FarmingCapacityThread = nil
            if HubDestroyed or RunIds.Farming ~= runId then return end
            local full = false
            if ok and type(result) == "\116\097\098\108\101" then
                local items = result.Items or result.items or result.Inventory or result
                local count = 0
                if type(items) == "\116\097\098\108\101" then
                    for _ in pairs(items) do count += 1 end
                end
                local capacity = tonumber(vehicle:GetAttribute("\067\097\114\103\111\067\097\112\097\099\105\116\121"))
                    or tonumber(vehicle:GetAttribute("\073\116\101\109\067\097\112\097\099\105\116\121"))
                    or tonumber(vehicle:GetAttribute("\083\116\111\114\097\103\101\067\097\112\097\099\105\116\121"))
                full = capacity ~= nil and capacity > 0 and count >= capacity
            end
            ThisHubInstance.FarmCapacityCache = {vehicle = vehicle, at = os.clock(), full = full}
        end)
    end

    return false, weight, limit
end

