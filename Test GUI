  if not settings.AllowAccessories then return 'Protected','Accessory sales disabled' end
  if settings.WornItems[id] or settings.AccessoryState[tostring(guid)]==true then return 'Protected','Currently worn accessory' end
  local state=settings.AccessoryState[tostring(guid)]
  if data.Equipped==false or data.IsEquipped==false then state=state==true and true or false end
  if state~=false then return 'Protected','Accessory equipment status unverified' end
 end
 local name=tostring(conf.Name or id)
