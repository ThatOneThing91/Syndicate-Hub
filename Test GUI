   star.object.BackgroundTransparency=0.42+(math.sin(elapsed*0.7+star.phase)+1)*0.20
  end
 end
end)

-- Drag freely; only settle back inside the display after release.
local snapTweens={}
local function cancelSnap(object)
 if snapTweens[object] then snapTweens[object]:Cancel(); snapTweens[object]=nil end
end
local function snapInside(object,animate)
 local camera=workspace.CurrentCamera; if not camera then return end
 local viewport=camera.ViewportSize
 local multiplier=object==root and scale.Scale or 1
 local size=Vector2.new(object.Size.X.Offset*multiplier,object.Size.Y.Offset*multiplier)
 local current=Vector2.new(object.Position.X.Offset,object.Position.Y.Offset)
 local target=Vector2.new(math.clamp(current.X,0,math.max(0,viewport.X-size.X)),
  math.clamp(current.Y,0,math.max(0,viewport.Y-size.Y)))
 cancelSnap(object)
 if (target-current).Magnitude<0.5 then return end
 local position=UDim2.fromOffset(target.X,target.Y)
 if animate then
  local tween=TweenService:Create(object,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=position})
  snapTweens[object]=tween; tween:Play()
 else object.Position=position end
end

