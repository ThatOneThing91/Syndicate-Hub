end)
-- Fit the logical window inside the available device area; reflow after rotation.
local function fit()
 local camera=workspace.CurrentCamera; if not camera then return end
 local size=camera.ViewportSize
 local inset=GuiService:GetGuiInset()
 scale.Scale=math.min(1,(size.X-24)/root.Size.X.Offset,(size.Y-inset.Y-42)/root.Size.Y.Offset)
 scale.Scale=math.max(0.1,scale.Scale)
 local px=root.Position.X.Offset; local py=root.Position.Y.Offset
 root.Position=UDim2.fromOffset(math.clamp(px,0,math.max(0,size.X-root.AbsoluteSize.X)),math.clamp(py,0,math.max(0,size.Y-inset.Y-root.AbsoluteSize.Y)))
end
local gesture
local function start(i,kind)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
  gesture={input=i,kind=kind,start=i.Position,position=root.Position,size=root.Size}
 end
end
connect(top.InputBegan,function(i) start(i,'move') end)
connect(grip.InputBegan,function(i) start(i,'resize') end)
connect(Input.InputChanged,function(i)
 if dragSlider and (i==dragSlider.input or i.UserInputType==Enum.UserInputType.MouseMovement and dragSlider.input.UserInputType==Enum.UserInputType.MouseButton1) then dragSlider.update(i.Position.X) end
 if not gesture then return end
 if not (i==gesture.input or i.UserInputType==Enum.UserInputType.MouseMovement and gesture.input.UserInputType==Enum.UserInputType.MouseButton1) then return end
 local delta=i.Position-gesture.start
 if gesture.kind=='move' then
  root.Position=UDim2.fromOffset(gesture.position.X.Offset+delta.X,gesture.position.Y.Offset+delta.Y)
 else
  root.Size=UDim2.fromOffset(math.clamp(gesture.size.X.Offset+delta.X/scale.Scale,690,1100),math.clamp(gesture.size.Y.Offset+delta.Y/scale.Scale,420,800))
 end
 fit()
end)
connect(Input.InputEnded,function(i)
 if gesture and i==gesture.input then gesture=nil end
 if dragSlider and i==dragSlider.input then dragSlider=nil end
end)
local function hide() root.Visible=false; restore.Visible=true end
connect(minimize.Activated,hide)
connect(restore.Activated,function() restore.Visible=false; root.Visible=true; fit() end)
connect(close.Activated,function() gui:Destroy() end)
connect(Input.InputBegan,function(i,processed)
 if not processed and i.KeyCode==Enum.KeyCode.RightShift then
  root.Visible=not root.Visible; restore.Visible=not root.Visible
 end
end)
local cameraConnection
local function watchCamera()
 if cameraConnection then cameraConnection:Disconnect() end
 local camera=workspace.CurrentCamera
 if camera then cameraConnection=connect(camera:GetPropertyChangedSignal('ViewportSize'),fit) end
 fit()
end
connect(workspace:GetPropertyChangedSignal('CurrentCamera'),watchCamera)
choose('Overview'); watchCamera()
