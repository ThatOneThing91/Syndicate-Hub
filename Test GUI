local Engine={}
local function normalize(value)
 if type(value)=='table' then value=value.name or value.Name end
 if type(value)~='string' then return nil end
 return value:match('^%s*(.-)%s*$'):lower()
end
function Engine.Evaluate(data,catalog,settings,guid)
 if type(data)~='table' then return 'Unknown','Invalid item data' end
 local id=tostring(data.ItemId or '')
 local conf=catalog.Items[id] or catalog.Items[tonumber(id)]
 if type(conf)~='table' then return 'Unknown','Item definition unavailable' end
 local isAccessory=conf.Category=='Accessories'
 if isAccessory then
  if not settings.AllowAccessories then return 'Protected','Accessory sales disabled' end
  if settings.WornItems[id] or settings.AccessoryState[tostring(guid)]==true then return 'Protected','Currently worn accessory' end
  local state=settings.AccessoryState[tostring(guid)]
  if data.Equipped==false or data.IsEquipped==false then state=state==true and true or false end
  if state~=false then return 'Protected','Accessory equipment status unverified' end
 end
 local name=tostring(conf.Name or id)
 local lower=name:lower()
 if data.Favorite==true or data.Favorited==true or data.IsFavorite==true
  or data.IsFavorited==true or data.Favourite==true or data.IsFavourite==true
  or data.Equipped==true or data.IsEquipped==true then
  return 'Protected','Favorite or equipped'
 end
 local rawId=data.ItemId or data.ItemID or data.itemId or data.itemID or data.Id or data.ID or data.id
 if tostring(rawId)=='359' then return 'Protected','Luck Drink 1' end
 local function protectedLabel(value)
  if type(value)~='string' then return false end
  local raw=value:lower()
  local compact=raw:gsub('[%s_%-]+','')
  if compact:find('seed',1,true)
   or compact:find('fishingrod',1,true)
   or compact:find('fishingpole',1,true)
   or compact:find('storagecrate',1,true)
   or compact:find('storagebox',1,true)
   or compact:find('luckdrink',1,true) then
   return true
  end
  return raw=='safe'
   or raw:match('^safe%s')~=nil
   or raw:match('%ssafe$')~=nil
   or raw:match('%ssafe%s')~=nil
 end
 local protectedFields={'Name','name','DisplayName','displayName','ItemName','itemName','Type','type',
  'ItemType','itemType','Category','category','Interactive','interactive','Class','class'}
 for _,field in ipairs(protectedFields) do
  if protectedLabel(data[field]) or protectedLabel(conf[field]) then
   return 'Protected','Protected item type'
  end
 end
 if data.IsSafe==true or data.isSafe==true or data.Safe==true or data.safe==true
  or data.IsSafe==1 or data.isSafe==1 or data.Safe==1 or data.safe==1
  or conf.IsSafe==true or conf.isSafe==true or conf.Safe==true or conf.safe==true
  or conf.IsSafe==1 or conf.isSafe==1 or conf.Safe==1 or conf.safe==1 then
  return 'Protected','Safe'
 end
 local normal,event={},{}
 local unknownMutation
 local function add(value)
  local key=normalize(value)
  if not key or key=='' or key=='none' then return end
  if catalog.EventNames[key] then event[key]=true
  elseif catalog.MutationNames[key] then normal[key]=true
  else unknownMutation=key end
 end
 if type(data.Mutators)=='table' then
  for k,v in pairs(data.Mutators) do
   if type(k)=='string' and (v==true or v==1) then add(k)
   elseif type(v)=='string' or type(v)=='table' then add(v) end
  end
 end
 for _,key in ipairs({'CleanMutation','PerfectMutation','TimeMutation','MiningMutation','EventMutation','Mutator'}) do add(data[key]) end
 if unknownMutation then return 'Unknown','Unrecognized mutation: '..unknownMutation end
 local selections=settings.Selected
 local checks={}
 local function selected(group) return next(selections[group])~=nil end
 if selected('Consumables') then checks[#checks+1]=selections.Consumables[id]==true end
 for _,group in ipairs({'Event Mutations','Mutations'}) do
  if selected(group) then
   local found=false
   local names=group=='Event Mutations' and event or normal
   for key in pairs(selections[group]) do if names[key] then found=true; break end end
   checks[#checks+1]=found
  end
 end
 if selected('Rarity') then
  local rarity=normalize(conf.Rarity)
  if not rarity then return 'Unknown','Rarity unavailable' end
  checks[#checks+1]=selections.Rarity[rarity]==true
 end
 if #checks==0 then return 'Keep','No selections' end
 local match=settings.Match=='All'
 for _,result in ipairs(checks) do
  if settings.Match=='All' then match=match and result else match=match or result end
 end
 local sell=(settings.Mode=='Sell Selected' and match) or (settings.Mode=='Keep Selected' and not match)
 return sell and 'Would sell' or 'Keep',match and 'Matches selection' or 'Does not match selection'
end
function Engine.SelectionMatch(data,catalog,settings,guid)
 if type(data)~='table' then return false,'Invalid item data' end
 local id=tostring(data.ItemId or data.itemId or data.ItemID or '')
 local conf=catalog.Items[id] or catalog.Items[tonumber(id)]
 if type(conf)~='table' then return false,'Item definition unavailable' end
 if conf.Category=='Accessories' then
  if not settings.AllowAccessories then return false,'Accessories excluded' end
  if settings.WornItems[id] or settings.AccessoryState[tostring(guid)]==true then return false,'Currently worn accessory' end
 end
 local selections=settings.Selected
 local checks={}
 if next(selections.Consumables)~=nil then checks[#checks+1]=selections.Consumables[id]==true end
 local normal,event={},{}
 local function add(value)
  local key=normalize(value)
  if not key or key=='' or key=='none' then return end
  if catalog.EventNames[key] then event[key]=true
  elseif catalog.MutationNames[key] then normal[key]=true end
 end
 if type(data.Mutators)=='table' then
  for k,v in pairs(data.Mutators) do
   if type(k)=='string' and v~=false and v~=nil then add(k)
   elseif type(v)=='string' or type(v)=='table' then add(v) end
  end
 end
 for _,key in ipairs({'CleanMutation','PerfectMutation','TimeMutation','MiningMutation','EventMutation','Mutator'}) do add(data[key]) end
 for _,group in ipairs({'Event Mutations','Mutations'}) do
  if next(selections[group])~=nil then
   local found=false
   local names=group=='Event Mutations' and event or normal
   for key in pairs(selections[group]) do if names[key] then found=true;break end end
   checks[#checks+1]=found
  end
 end
 if next(selections.Rarity)~=nil then
  local rarity=normalize(conf.Rarity or data.Rarity)
  checks[#checks+1]=rarity~=nil and selections.Rarity[rarity]==true
 end
 if #checks==0 then return false,'No selections' end
 for _,matched in ipairs(checks) do if matched then return true,'Matches selection' end end
 return false,'Does not match selection'
end
function Engine.Value(data,catalog)
 if type(data)~='table' then return 0 end
 local id=tostring(data.ItemId or '')
 local conf=catalog.Items[id] or catalog.Items[tonumber(id)]
 if type(conf)~='table' then return 0 end
 local base=tonumber(conf.BasePrice) or 0
 local value=base
 local module=catalog.MutatorModule
 if type(module)=='table' and type(module.CalculatePriceForEntry)=='function' then
  pcall(function() value=module:CalculatePriceForEntry(base,data) or base end)
 end
 return tonumber(value) or 0
end
function Engine.DisplayDetails(data,catalog)
 if type(data)~='table' then return 'Unknown','No mutation' end
 local id=tostring(data.ItemId or data.itemId or data.ItemID or '')
 local conf=catalog.Items[id] or catalog.Items[tonumber(id)] or {}
 local rarity=tostring(conf.Rarity or data.Rarity or 'Unknown')
 local mutations,seen={},{}
 local function add(value)
  if type(value)=='table' then value=value.Name or value.name end
  if type(value)~='string' then return end
  local text=value:match('^%s*(.-)%s*$')
  if text=='' or text:lower()=='none' then return end
  local key=text:lower()
  if not seen[key] then seen[key]=true;mutations[#mutations+1]=text end
 end
 if type(data.Mutators)=='table' then
  for k,v in pairs(data.Mutators) do
   if type(k)=='string' and v~=false and v~=nil then add(k)
   elseif type(v)=='string' or type(v)=='table' then add(v) end
  end
 end
 for _,field in ipairs({'CleanMutation','PerfectMutation','TimeMutation','MiningMutation','EventMutation','Mutator'}) do add(data[field]) end
 table.sort(mutations,function(a,b) return a:lower()<b:lower() end)
 return rarity,#mutations>0 and table.concat(mutations,', ') or 'No mutation'
end

