-- Small native outline icons; consistent stroke weight without bitmap assets.
local function drawNavIcon(host,name)
 local parts={}
 local function line(x1,y1,x2,y2)
  local dx,dy=x2-x1,y2-y1
  local item=frame(host,{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromOffset((x1+x2)/2,(y1+y2)/2),
   Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),1.4),Rotation=math.deg(math.atan2(dy,dx)),BackgroundColor3=muted})
  make('UICorner',{CornerRadius=UDim.new(1,0)},item)
  table.insert(parts,{object=item,stroke=false})
 end
 local function outline(x,y,w,h,radius)
  local shape=frame(host,{Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundTransparency=1})
  make('UICorner',{CornerRadius=UDim.new(0,radius or 2)},shape)
  local stroke=make('UIStroke',{Color=muted,Thickness=1.4,Transparency=0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},shape)
  table.insert(parts,{object=stroke,stroke=true})
 end
 if name=='Account' then
  outline(7,2,8,8,4); outline(3,13,16,7,3)
 elseif name=='Farming' then
  line(5,19,16,5); line(9,14,6,9); line(12,10,17,11)
  outline(3,5,6,5,3); outline(13,3,6,5,3)
 elseif name=='Shop' then
  outline(3,7,16,13,2); outline(7,2,8,8,3)
 elseif name=='Quick Sell' then
  line(3,3,12,3); line(12,3,20,11); line(20,11,11,20)
  line(11,20,3,12); line(3,12,3,3); outline(6,6,3,3,2)
 elseif name=='Grading' then
  line(11,2,20,11); line(20,11,11,20); line(11,20,2,11); line(2,11,11,2)
  line(7,11,10,14); line(10,14,15,8)
 elseif name=='Event' then
  outline(3,5,16,15,2); line(3,10,19,10); line(7,2,7,7); line(15,2,15,7)
  line(7,14,9,14); line(13,14,15,14); line(7,17,9,17)
 elseif name=='Appearance' then
  -- Diagonal brush: tapered handle, ferrule, and a curved-looking bristle tip.
  line(9,12,16,3); line(16,3,18,2); line(18,2,20,4)
  line(20,4,19,6); line(19,6,12,15); line(9,12,12,15)
  line(11,10,14,13)
  line(9,13,6,13); line(6,13,4,15); line(4,15,4,18)
  line(4,18,2,20); line(2,20,7,20); line(7,20,10,18); line(10,18,11,15)
 elseif name=='Settings' then
  outline(5,5,12,12,6); outline(8,8,6,6,3)
  for i=0,7 do
   local angle=i*math.pi/4
   line(11+math.cos(angle)*6,11+math.sin(angle)*6,11+math.cos(angle)*9,11+math.sin(angle)*9)
  end
 end
 return parts
end
local navTweens={}
local function paintTab(t,selected,hovered)
 if navTweens[t] then navTweens[t]:Cancel() end
 local tween=TweenService:Create(t.button,TweenInfo.new(0.16,Enum.EasingStyle.Quad),{
  BackgroundTransparency=selected and 0.25 or (hovered and 0.65 or 1),
  BackgroundColor3=selected and accent:Lerp(Color3.fromRGB(24,17,39),0.64) or Color3.fromRGB(44,33,62)})
 navTweens[t]=tween; tween:Play()
 t.caption.TextColor3=selected and ink or muted
 t.border.Transparency=selected and 0.7 or 1
 t.indicator.Visible=selected
 for _,part in ipairs(t.iconParts) do
  local color=selected and accent or (hovered and ink or muted)
  if part.stroke then part.object.Color=color; part.object.Transparency=0
  else part.object.BackgroundColor3=color; part.object.BackgroundTransparency=0 end
 end
end
