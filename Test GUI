 local function readInventorySafety()
  local states,worn,favorites={},{},{}
  local character=player.Character
  if character then
   for _,object in ipairs(character:GetDescendants()) do
    if object:IsA('Accessory') then
     for _,key in ipairs({'UUID','Guid','GUID'}) do
      local id=object:GetAttribute(key);if id then states[tostring(id)]=true end
     end
     for _,key in ipairs({'ItemId','ItemID'}) do
      local id=object:GetAttribute(key);if id then worn[tostring(id)]=true end
     end
    end
   end
  end
  local ok,full=pcall(function()
   return game:GetService('ReplicatedStorage').Events.Inventory.GetPlayerInventory:InvokeServer()
  end)
  if ok and type(full)=='table' then
   local visited={}
   local function equipFlag(entry)
    local explicitFalse=false
    for _,key in ipairs({'Equipped','equipped','IsEquipped','isEquipped','Wearing','wearing','Worn','worn','IsWorn','isWorn','IsWearing','isWearing'}) do
     local value=entry[key]
     if value==true or value==1 or value=='true' or value=='equipped' or value=='worn' or value=='wearing' then return true end
     if value==false or value==0 or value=='false' then explicitFalse=true end
    end
    local slot=entry.EquippedSlot or entry.equippedSlot or entry.WearSlot or entry.wearSlot
    if slot~=nil and tostring(slot)~='' and tostring(slot)~='0' then return true end
    if explicitFalse then return false end
    return nil
   end
   local function favoriteFlag(entry)
    for _,key in ipairs({'Favorite','favorite','Favorited','favorited','IsFavorite','isFavorite','IsFavorited','isFavorited','Favourite','favourite','IsFavourite','isFavourite'}) do
     local value=rawget(entry,key)
     if value==true or value==1 then return true end
     if type(value)=='string' then
      local lower=value:lower()
      if lower=='true' or lower=='favorite' or lower=='favorited' then return true end
     end
    end
    return false
   end
   local function scan(entry,depth,inheritedFavorite)
    if type(entry)~='table' or visited[entry] or depth>12 then return end
    visited[entry]=true
    local hereFavorite=inheritedFavorite or favoriteFlag(entry)
    for key,value in pairs(entry) do
     if type(value)=='table' then
      local id=value.UUID or value.Guid or value.GUID or value.UniqueId
      if not id and type(key)=='string' and #key==36 and key:find('-',1,true) then id=key end
      local keyLower=type(key)=='string' and key:lower() or ''
      local childFavorite=hereFavorite or keyLower=='favorites' or keyLower=='favourites' or favoriteFlag(value)
      local state=equipFlag(value)
      if id and state~=nil then
       id=tostring(id);if state or states[id]~=true then states[id]=state end
      end
      if id and childFavorite then favorites[tostring(id)]=true end
      scan(value,depth+1,childFavorite)
     end
    end
   end
   scan(full,0,false)
  end
  return states,worn,favorites
 end
