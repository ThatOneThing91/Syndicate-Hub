local toastVersion=0
local function notify(message)
 if not notifications then return end
 toastVersion=toastVersion+1; local version=toastVersion
 toast.Text=message; toast.Visible=true
 task.delay(3,function() if gui.Parent and version==toastVersion then toast.Visible=false end end)
end
local function choose(name)
 active=name; title.Text=name; search.Text=''
 for n,t in pairs(tabs) do
  t.page.Visible=n==name
  t.button.BackgroundTransparency=n==name and 0 or 1
  t.button.TextColor3=n==name and accent or muted
 end
end
local order=0
local function page(name, icon)
 local b=button(nav,icon..'  '..name,{Size=UDim2.new(1,0,0,35),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1})
 make('UIPadding',{PaddingLeft=UDim.new(0,10)},b)
 local p=make('ScrollingFrame',{Position=UDim2.fromOffset(0,61),Size=UDim2.new(1,0,1,-61),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=accent,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,Visible=false},body)
 make('UIListLayout',{Padding=UDim.new(0,9),SortOrder=Enum.SortOrder.LayoutOrder},p)
 make('UIPadding',{PaddingRight=UDim.new(0,9),PaddingBottom=UDim.new(0,12)},p)
 tabs[name]={page=p,button=b}; rows[name]={}
 connect(b.Activated,function() choose(name) end)
 return p
end
local function section(p,text)
 order=order+1
 return label(p,text,{Size=UDim2.new(1,0,0,23),TextColor3=muted,TextSize=10,LayoutOrder=order})
end
local function row(p,name,desc,height)
 order=order+1
 local r=frame(p,{Size=UDim2.new(1,0,0,height or 66),BackgroundColor3=Color3.fromRGB(36,26,50),BackgroundTransparency=opacity,LayoutOrder=order})
 table.insert(surfaces,r)
 label(r,name,{Position=UDim2.fromOffset(14,12),Size=UDim2.new(1,-140,0,18),TextSize=14})
 label(r,desc,{Position=UDim2.fromOffset(14,34),Size=UDim2.new(1,-140,0,24),TextColor3=muted,TextSize=11,TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top})
 for n,t in pairs(tabs) do if t.page==p then table.insert(rows[n],{frame=r,text=(name..' '..desc):lower()}) end end
 return r
end
local function toggle(p,name,desc,default,callback)
 local r=row(p,name,desc); local value=default or false
 local b=button(r,'',{Position=UDim2.new(1,-70,0,22),Size=UDim2.fromOffset(54,24)})
 local pixel=frame(b,{Size=UDim2.fromOffset(16,16),Position=UDim2.fromOffset(4,4),BackgroundColor3=ink})
 local function draw()
  b.BackgroundColor3=value and accent or Color3.fromRGB(64,53,80)
  pixel.Position=UDim2.fromOffset(value and 34 or 4,4)
 end
 connect(b.Activated,function() value=not value; draw(); if callback then callback(value) end end)
 draw(); return draw
end
local function action(p,name,desc,caption,callback)
 local r=row(p,name,desc)
 local b=button(r,caption,{Position=UDim2.new(1,-108,0,20),Size=UDim2.fromOffset(92,28)})
 connect(b.Activated,callback or function() notify(name..' / demo only') end)
end
local dragSlider
local function slider(p,name,desc,lo,hi,value,callback)
 local r=row(p,name,desc,98)
 local valueLabel=label(r,tostring(value),{Position=UDim2.new(1,-90,0,12),Size=UDim2.fromOffset(74,20),TextXAlignment=Enum.TextXAlignment.Right})
 local track=button(r,'',{Position=UDim2.fromOffset(14,74),Size=UDim2.new(1,-28,0,12),BackgroundColor3=Color3.fromRGB(65,50,82)})
 local fill=tint(frame(track,{Size=UDim2.fromScale((value-lo)/(hi-lo),1)}),'BackgroundColor3')
 local function set(v)
  value=math.clamp(math.floor(v+0.5),lo,hi); valueLabel.Text=tostring(value)
  fill.Size=UDim2.fromScale((value-lo)/(hi-lo),1)
  if callback then callback(value) end
 end
 local function update(x) set(lo+(hi-lo)*math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)) end
 connect(track.InputBegan,function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
   dragSlider={input=i,update=update}; update(i.Position.X)
  end
 end)
 connect(track.InputBegan,function(i)
  if i.KeyCode==Enum.KeyCode.DPadLeft then set(value-1) elseif i.KeyCode==Enum.KeyCode.DPadRight then set(value+1) end
 end)
 connect(track.Activated,function(i)
  if i and i.UserInputType==Enum.UserInputType.Gamepad1 then set(value>=hi and lo or value+1) end
 end)
 return set
end
local function cycle(p,name,desc,options,callback)
 local index=1; local r=row(p,name,desc)
 local b=button(r,options[1]..' >',{Position=UDim2.new(1,-118,0,20),Size=UDim2.fromOffset(102,28)})
 connect(b.Activated,function()
  index=index%#options+1; b.Text=options[index]..' >'; if callback then callback(options[index]) end
 end)
end
