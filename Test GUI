local function connect(event, fn)
 local c = event:Connect(fn); table.insert(connections, c); return c
end
local function make(kind, props, host)
 local x = Instance.new(kind)
 for k,v in pairs(props) do x[k] = v end
 x.Parent = host
 return x
end
local function tint(x, prop)
 x[prop] = accent; table.insert(themes, {x, prop}); return x
end
local function frame(host, props)
 props.BorderSizePixel = 0
 return make('Frame', props, host)
end
local function label(host, text, props)
