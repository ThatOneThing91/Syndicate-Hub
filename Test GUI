-- Fit the window scale to the device without restricting dragging.
local function fit()
 local camera=workspace.CurrentCamera; if not camera then return end
 local size=camera.ViewportSize
 -- Scale for device size only. Never alter a user-selected window position.
 scale.Scale=math.clamp(math.min(1,(size.X-24)/root.Size.X.Offset,(size.Y-24)/root.Size.Y.Offset),0.1,1)
end
local gesture
local function start(i,kind)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
  cancelSnap(root)
  gesture={input=i,kind=kind,start=i.Position,position=root.Position,size=root.Size,scale=scale.Scale}
 end
end
connect(top.InputBegan,function(i) start(i,'move') end)
connect(grip.InputBegan,function(i) start(i,'resize') end)
connect(Input.InputChanged,function(i)
 if dragSlider and (i==dragSlider.input or i.UserInputType==Enum.UserInputType.MouseMovement and dragSlider.input.UserInputType==Enum.UserInputType.MouseButton1) then dragSlider.update(i.Position.X) end
 if not gesture then return end
 if not (i==gesture.input or i.UserInputType==Enum.UserInputType.MouseMovement and gesture.input.UserInputType==Enum.UserInputType.MouseButton1) then return end
 local delta=i.Position-gesture.start
 if gesture.kind=='move' then
  root.Position=UDim2.fromOffset(gesture.position.X.Offset+delta.X,gesture.position.Y.Offset+delta.Y)
 else
  root.Size=UDim2.fromOffset(math.clamp(gesture.size.X.Offset+delta.X/gesture.scale,360,1100),math.clamp(gesture.size.Y.Offset+delta.Y/gesture.scale,280,800))
 end
 fit()
end)
