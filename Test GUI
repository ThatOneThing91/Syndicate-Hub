-- Reflow text and controls, keeping every control inside its scrolling page.
local function measure(text,size,width)
 return math.ceil(TextService:GetTextSize(text,size,Enum.Font.Code,Vector2.new(math.max(40,width),10000)).Y)+2
end
local reflowing=false
local function reflow()
 if reflowing then return end
 reflowing=true
 local narrow=root.Size.X.Offset<560
 if narrow and not navCollapsed then setNavCollapsed(true)
 elseif not narrow and navCollapsed~=preferredNavCollapsed then setNavCollapsed(preferredNavCollapsed) end
 -- Use logical coordinates so scaling and touch-device viewport fitting agree.
 local width=root.Size.X.Offset-(navCollapsed and 48 or 118)-32
 local stackedHeader=width<430
 title.Size=UDim2.new(1,stackedHeader and 0 or -185,0,26)
 subtitle.Visible=not stackedHeader
 search.Position=stackedHeader and UDim2.fromOffset(0,34) or UDim2.new(1,-177,0,0)
 search.Size=stackedHeader and UDim2.new(1,0,0,28) or UDim2.fromOffset(177,28)
 local pageTop=stackedHeader and 76 or 61
 local rowWidth=width-9
 for _,t in pairs(tabs) do
  t.page.Position=UDim2.fromOffset(0,pageTop)
  t.page.Size=UDim2.new(1,0,1,-pageTop)
  t.page.ScrollingDirection=Enum.ScrollingDirection.Y
 end
 for _,heading in ipairs(sectionSpecs) do
  heading.Size=UDim2.new(1,0,0,math.max(23,measure(heading.Text,10,rowWidth)))
 end
 for r,spec in pairs(rowSpecs) do
  local compact=rowWidth<400
  local reserve=(spec.control or spec.value) and not compact and 140 or 28
  local textWidth=math.max(80,rowWidth-reserve)
  local headingWidth=spec.kind=='slider' and textWidth-70 or textWidth
  local h=measure(spec.heading.Text,14,headingWidth)
  local d=measure(spec.description.Text,11,textWidth)
  spec.heading.Size=UDim2.fromOffset(headingWidth,h)
  spec.description.Position=UDim2.fromOffset(14,16+h)
  spec.description.Size=UDim2.fromOffset(textWidth,d)
  local bottom=16+h+d+12
  if spec.kind=='slider' then
   spec.value.Position=UDim2.new(1,-90,0,12)
   spec.control.Position=UDim2.fromOffset(14,bottom)
   r.Size=UDim2.new(1,0,0,bottom+26)
  elseif spec.kind=='palette' then
   local columns=compact and 3 or 5
   local gridRows=math.ceil(10/columns)
   paletteGrid.CellSize=UDim2.new(1/columns,-5,0,28)
   swatches.Position=UDim2.fromOffset(14,bottom)
   swatches.Size=UDim2.new(1,-28,0,gridRows*33)
   r.Size=UDim2.new(1,0,0,bottom+gridRows*33+12)
  elseif spec.control then
   if compact then
    spec.control.Position=UDim2.new(1,-spec.control.Size.X.Offset-14,0,bottom)
    r.Size=UDim2.new(1,0,0,bottom+spec.control.Size.Y.Offset+12)
   else
    spec.control.Position=UDim2.new(1,-spec.control.Size.X.Offset-14,0,20)
    r.Size=UDim2.new(1,0,0,math.max(66,bottom))
   end
  elseif spec.value then
   spec.value.Position=compact and UDim2.new(1,-112,0,bottom) or UDim2.new(1,-112,0,22)
   r.Size=UDim2.new(1,0,0,compact and bottom+34 or math.max(66,bottom))
  else r.Size=UDim2.new(1,0,0,math.max(66,bottom)) end
 end
