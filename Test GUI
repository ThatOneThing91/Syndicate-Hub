local starLayer=frame(sky,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1})
-- Faint constellation fragments complement the small drifting stars.
local points={{0.12,0.23},{0.21,0.16},{0.31,0.28},{0.42,0.19},{0.67,0.72},{0.79,0.64},{0.88,0.78}}
local links={}
for i,point in ipairs(points) do
 local dot=frame(starLayer,{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(point[1],point[2]),
  Size=UDim2.fromOffset(3,3),BackgroundColor3=ink,BackgroundTransparency=0.3})
 if i~=1 and i~=5 then
  local line=frame(starLayer,{AnchorPoint=Vector2.new(0,0.5),BackgroundColor3=accent,BackgroundTransparency=0.88})
  table.insert(links,{object=line,a=points[i-1],b=point})
 end
end
local function layoutConstellations()
 local size=starLayer.AbsoluteSize
 for _,link in ipairs(links) do
  local a=Vector2.new(link.a[1]*size.X,link.a[2]*size.Y)
  local b=Vector2.new(link.b[1]*size.X,link.b[2]*size.Y)
  local delta=b-a
  link.object.Position=UDim2.fromOffset(a.X,a.Y)
  link.object.Size=UDim2.fromOffset(delta.Magnitude,1)
  link.object.Rotation=math.deg(math.atan2(delta.Y,delta.X))
 end
end
connect(starLayer:GetPropertyChangedSignal('AbsoluteSize'),layoutConstellations)
layoutConstellations()
local meteor=frame(starLayer,{Size=UDim2.fromOffset(75,2),BackgroundColor3=ink,Rotation=24,Visible=false})
make('UIGradient',{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0.12)})},meteor)
local random=Random.new(91)
local stars={}
for i=1,42 do
 local size=i%9==0 and 3 or (i%3==0 and 2 or 1)
 local star=frame(starLayer,{Size=UDim2.fromOffset(size,size),
  Position=UDim2.fromScale(random:NextNumber(),random:NextNumber()),
  BackgroundColor3=Color3.fromRGB(211,191,255),BackgroundTransparency=0.6})
 table.insert(stars,{object=star,x=random:NextNumber(),y=random:NextNumber(),
  phase=random:NextNumber(0,math.pi*2),speed=random:NextNumber(0.001,0.003)})
end
local elapsed,accumulator=0,0
connect(RunService.Heartbeat,function(dt)
 if not root.Visible or not animatedSky then return end
 accumulator=accumulator+dt
 if accumulator<0.05 then return end
 elapsed=elapsed+accumulator; accumulator=0
 for i,cloud in ipairs(nebulae) do
  cloud.Position=UDim2.fromScale(0.2+i*0.17+math.sin(elapsed*0.075+i)*0.12,0.2+i*0.15+math.cos(elapsed*0.065+i)*0.09)
  cloud.Rotation=-28+i*14+math.sin(elapsed*0.04+i)*12
 end
 local meteorPhase=elapsed%11
 meteor.Visible=showStars and meteorPhase<1.15
 if meteor.Visible then meteor.Position=UDim2.fromScale(-0.16+meteorPhase*1.05,0.08+meteorPhase*0.48) end
 skyGradient.Rotation=25+math.sin(elapsed*0.09)*22
 skyGradient.Offset=Vector2.new(math.sin(elapsed*0.07)*0.17,math.cos(elapsed*0.06)*0.12)
 if showStars then
  for _,star in ipairs(stars) do
   star.object.Position=UDim2.fromScale(star.x,(star.y-elapsed*star.speed)%1)
   star.object.BackgroundTransparency=0.48+(math.sin(elapsed*0.7+star.phase)+1)*0.2
  end
 end
end)

