-- Standalone interface prototype. Put in a LocalScript under StarterPlayerScripts.
-- Demo controls change UI state only. No game automation or external dependencies.
local Players = game:GetService('Players')
local Input = game:GetService('UserInputService')
local GuiService = game:GetService('GuiService')
local player = Players.LocalPlayer
assert(player, 'Run AmethystPixel from a client LocalScript')
local parent = player:WaitForChild('PlayerGui')
local old = parent:FindFirstChild('AmethystPixel')
if old then old:Destroy() end
local connections, themes, surfaces, rows, tabs = {}, {}, {}, {}, {}
local accent = Color3.fromRGB(176, 119, 255)
local ink = Color3.fromRGB(239, 233, 255)
local muted = Color3.fromRGB(157, 146, 179)
local opacity, active, notifications = 0.18, 'Overview', true
local function connect(event, fn)
 local c = event:Connect(fn); table.insert(connections, c); return c
end
local function make(kind, props, host)
 local x = Instance.new(kind)
 for k,v in pairs(props) do x[k] = v end
 x.Parent = host
 return x
end
local function tint(x, prop)
 x[prop] = accent; table.insert(themes, {x, prop}); return x
end
local function frame(host, props)
 props.BorderSizePixel = 0
 return make('Frame', props, host)
end
local function label(host, text, props)
 local p = {Text=text, Font=Enum.Font.Code, TextSize=13, TextColor3=ink,
 BackgroundTransparency=1, BorderSizePixel=0, TextXAlignment=Enum.TextXAlignment.Left}
 for k,v in pairs(props or {}) do p[k]=v end
 return make('TextLabel', p, host)
end
local function button(host, text, props)
 local p = {Text=text, Font=Enum.Font.Code, TextSize=13, TextColor3=ink,
 BackgroundColor3=Color3.fromRGB(43,33,62), BorderSizePixel=0, AutoButtonColor=true, Selectable=true}
 for k,v in pairs(props or {}) do p[k]=v end
 return make('TextButton', p, host)
end
