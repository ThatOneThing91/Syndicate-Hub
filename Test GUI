 if data.Favorite==true or data.Favorited==true or data.IsFavorite==true or data.Equipped==true or data.IsEquipped==true then
  return 'Protected','Favorite or equipped'
 end
 if lower=='luck drink 1' or lower:find('seeds',1,true) or lower:find('fishing rod',1,true) or lower:find('storage crate',1,true) or lower:find('safe',1,true) then
  return 'Protected','Protected item type'
 end
