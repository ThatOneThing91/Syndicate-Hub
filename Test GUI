connect(restore.InputBegan,function(i)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
  cancelSnap(restore)
  iconGesture={input=i,start=i.Position,position=restore.Position,dragged=false}
 end
end)
connect(Input.InputChanged,function(i)
 local g=iconGesture
 if not g or not (i==g.input or i.UserInputType==Enum.UserInputType.MouseMovement and g.input.UserInputType==Enum.UserInputType.MouseButton1) then return end
 local delta=i.Position-g.start
 if delta.Magnitude>6 then g.dragged=true end
 if g.dragged then
  suppressIconUntil=os.clock()+0.3
  restore.Position=UDim2.fromOffset(g.position.X.Offset+delta.X,g.position.Y.Offset+delta.Y)
 end
end)
connect(Input.InputEnded,function(i)
 if iconGesture and i==iconGesture.input then
  if iconGesture.dragged then suppressIconUntil=os.clock()+0.3 end
  iconGesture=nil
  snapInside(restore,true)
 end
end)
