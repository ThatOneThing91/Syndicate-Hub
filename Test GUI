local function toggle(p,name,desc,default,callback)
 local r=row(p,name,desc); local value=default or false
 local b=button(r,'',{Position=UDim2.new(1,-70,0,22),Size=UDim2.fromOffset(54,24)})
 local pixel=frame(b,{Size=UDim2.fromOffset(16,16),Position=UDim2.fromOffset(4,4),BackgroundColor3=ink})
 local function draw()
  b.BackgroundColor3=value and accent or Color3.fromRGB(64,53,80)
  pixel.Position=UDim2.fromOffset(value and 34 or 4,4)
 end
 connect(b.Activated,function() value=not value; draw(); if callback then callback(value) end end)
 table.insert(toggleDraws,draw)
 draw(); return draw
end
