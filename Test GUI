 local function loadCatalog()
  if loading then return end;loading=true
  task.spawn(function()
   local ok,err=pcall(function()
    local RS=game:GetService('ReplicatedStorage')
    local modules=RS:WaitForChild('Modules',8);assert(modules,'Modules unavailable')
    local function module(name)
     local object=modules:FindFirstChild(name);assert(object,name..' module unavailable')
     local result=require(object);assert(type(result)=='table',name..' did not return a table');return result
    end
    local items=module('Items');local drinks=module('EnergyDrinks');local accessories=module('Accessories');local mutations=module('MutatorModule')
    local newCatalog={Items=items,EventNames={},MutationNames={}}
    local fresh={};local seen={};for _,group in ipairs(groups) do fresh[group]={};seen[group]={} end
    local function add(group,key,name)
     if not key or seen[group][key] then return end
     seen[group][key]=true;fresh[group][#fresh[group]+1]={key=key,name=name}
    end
    for id,conf in pairs(items) do
     if type(conf)=='table' then
      if type(conf.Rarity)=='string' then add('Rarity',conf.Rarity:lower(),conf.Rarity) end
      
      if conf.EnergyDrinkId~=nil then add('Consumables',tostring(id),tostring(conf.Name or id)) end
     end
    end
    for _,conf in pairs(drinks) do
     if type(conf)=='table' and conf.ItemId then add('Consumables',tostring(conf.ItemId),tostring(conf.Name or conf.ItemId)) end
    end
    local function mutationGroup(field,destination)
     local entries=mutations[field]
     if type(entries)~='table' then return end
     for _,conf in pairs(entries) do
      if type(conf)=='table' and type(conf.Name)=='string' then
       local key=conf.Name:lower();add(destination,key,conf.Name)
       if destination=='Event Mutations' then newCatalog.EventNames[key]=true else newCatalog.MutationNames[key]=true end
      end
     end
    end
    mutationGroup('EventMutations','Event Mutations')
    for _,field in ipairs({'Mutations','MiningMutations','TimeMutations','CleanMutations','PerfectMutations','FlagMutations','TagMutations'}) do mutationGroup(field,'Mutations') end
    local mutationsAvailable=#fresh['Event Mutations']>0 and #fresh.Mutations>0
    for _,group in ipairs(groups) do table.sort(fresh[group],function(a,b) return a.name:lower()<b.name:lower() end) end
    if not gui.Parent then return end
    catalog=newCatalog;options=fresh;loaded=true
